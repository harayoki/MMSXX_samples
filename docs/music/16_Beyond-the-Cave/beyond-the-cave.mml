#ch fm4 // fm: 同
  t150 @{fmStac}
  r1
  r1
  r1
  r1
  r1
  r1
  r1
  r1
  r1
  r1
  r8 v10 o4 f12 r6 f12 r6 f12 r6 f12 r24
  r8 g12 r6 g12 r6 g12 r6 g12 r24
  r8 f12 r6 f12 r6 f12 r6 f12 r24
  r8 f12 r6 f12 r6 f12 r6 f12 r24
  r8 g12 r6 g12 r6 g12 r6 g12 r24
  r8 e12 r6 e12 r6 e12 r6 e12 r24
  r8 f12 r6 f12 r6 f12 r6 f12 r24
  r8 e12 r6 e12 r6 e12 r6 e12 r24
