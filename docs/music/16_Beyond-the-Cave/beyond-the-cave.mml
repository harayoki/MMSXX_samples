#ch fm6 // fm: 重ね(A はバイオリン / B は鐘)
  t150 @{opll::violin} @m{25, 1.1}
  r1
  r1
  @{opll::violin}
  v7 o5 a4. > d8 d4 e8 f8
  e4. d8 c4 d4
  d4. c8 < a+4 a8 a+8
  > c2 e4 g4
  f4. e8 d4 < a4
  > d4 e8 f8 g4 a4
  a+4. a8 g4. e8
  a2 e4 c+4
  @{bell}
  v9 o4 a4 > c4 f2
  e4. d8 c4 < g4
  a4. a+8 > c4 d4
  f2 d4 < a+4
  g4 a+4 > d4 g4
  e4. c+8 e4 g4
  f4. e8 d4 a4
  e4 d4 c+2
  r1
  r1

#ch drums // fm: ドラム。もとは OPLL のリズムモードでした
