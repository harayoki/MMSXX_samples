// Opening brass. The attack is an OPLL user voice; the body blends SCC sawtooth waves as it opens.
#voice brHead = @opll{ mod{ratio 1, depth 14, attack 15, decay 7, sustain 12, release 8, hold 0}, car{ratio 1, attack 15, decay 7, sustain 15, release 8, hold 0}, feedback 6 }
#voice brBody = @{sccW1} @sccseq{sccW1 10 >2 sccW2 10 >2 sccW3 10 >2 sccW5 10 >2 sccW6 10 >2 sccW7} @vol{4, 7, 10, 12, 13, 13, 13}
#voice brass = @{brHead}, @{brBody} @gain{0.6}
// Unison bass. OPLL synth and SCC sawtooth play the same note; SCC is 12 cents sharp so they beat.
// Fat bass. OPLL synthBass with a 2-harmonic SCC sawtooth layered underneath for weight. The SCC part decays a little, then sustains.
#voice fatBassBody = @{sccW2} @vol{15, 15, 14, 14, 13, 13, 12, 12, 11, 11, 10}
#voice fatBass = @{opll::synthBass}, @{fatBassBody} @gain{1.2}
