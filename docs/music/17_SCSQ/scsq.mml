// OPLL user voices (4). Modulation near maximum on all. From 1 to 4 the modulator multiple rises for deeper modulation. Half-sine wave. On hardware these rewrite the same registers.
#voice fm1 = @opll{ mod{ratio 1, depth 12, attack 15, decay 3, sustain 4, release 7, hold 0, wave 1}, car{ratio 1, attack 15, decay 4, sustain 5, release 7, hold 0, wave 1}, feedback 6 }
#voice fm2 = @opll{ mod{ratio 3, depth 8, attack 15, decay 3, sustain 4, release 7, hold 0, wave 1}, car{ratio 1, attack 15, decay 4, sustain 5, release 7, hold 0, wave 1}, feedback 7 }
#voice fm3 = @opll{ mod{ratio 5, depth 4, attack 15, decay 3, sustain 4, release 7, hold 0, wave 1}, car{ratio 1, attack 15, decay 4, sustain 5, release 7, hold 0, wave 1}, feedback 7 }
#voice fm4 = @opll{ mod{ratio 7, depth 0, attack 15, decay 3, sustain 4, release 7, hold 0, wave 1}, car{ratio 1, attack 15, decay 4, sustain 5, release 7, hold 0, wave 1}, feedback 7 }

// Opening chord. Held while the SCC wave steps through 24 stages.
// The waves come from the FM formula, modulation depth 0 to 12. Blends every 6 frames (@sccseq >).
#voice openPad = @{fmA0} @sccseq{fmA0 22 >6 fmA1 22 >6 fmA2 22 >6 fmA3 22 >6 fmA4 22 >6 fmA5 22 >6 fmA6 22 >6 fmA7 22 >6 fmA8 22 >6 fmA9 22 >6 fmA10 22 >6 fmA11 22 >6 fmA12 22 >6 fmA13 22 >6 fmA14 22 >6 fmA15 22 >6 fmA16 22 >6 fmA17 22 >6 fmA18 22 >6 fmA19 22 >6 fmA20 22 >6 fmA21 22 >6 fmA22 22 >6 fmA23}

// Falling lead: a sync lead. Each note raises the sync ratio from 1 to 5 over 36 frames.
#voice fall = @{sy0} @sccseq{sy0 4 > sy1 4 > sy2 4 > sy3 4 > sy4 4 > sy5 4 > sy6} @slide{300, 8} @vol{15, 15, 14, 14, 13, 13, 12, 12, 11}
// Wobble: pitch moves up and down every frame. Played on OPLL flute to keep PSG free.
#voice wobble = @{opll::flute} @pitch{0, 80, 0, -80} @loop{pitch 0} @vol{12, 12, 11, 11, 10, 10, 9, 9, 8, 8, 7, 7, 6, 6, 5, 5, 4, 4, 3, 3, 2, 2, 1, 1, 0}

// PWM lead. Bends up from 200 cents below (like koto or shamisen). 15 pulse waves from 50% to 6% duty, narrowing and widening every 2 frames.
#voice pw2 = @scc{ bytes{112, 112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112, -112} }
