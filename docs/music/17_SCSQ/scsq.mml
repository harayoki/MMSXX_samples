#title SCSQ（スクシーク）
#about MSX らしからぬ *いい音* を、令和の技術で出してみようという試みの曲。
#about 基本的には PSG・MSX-MUSIC・SCC だけで鳴ってます。（エフェクトOFFの場合）
#about 5波形同時に使っているので実機に準ずる環境ではSCC+(SCC-I)が必要となります。
// Requires the addon: samples/addons/opllpsg808

#fx tp = tape @speed 15
#fx jet = flanger @rate 0.08 @feedback 0.5 @mix 0.2
#fx room = plate 1.8 @predelay 20 @mix 0.15
#fx glue = compressor @threshold -18 @ratio 2 @attack 0.02 @release 0.2 @makeup 3
#fx ceil = limiter @ceiling -1
#gain 1.4
// Buses apply shared filters once. Page playback only; dropped for hardware.
#bus open = OpenChord1 OpenChord2 OpenChord3
#fx open1 = highpass 200
#fx open2 = lowpass 5000 @resonance 0
#bus stab = Stab1 Stab2 Stab3
#fx stab1 = highpass 250
#bus pad = Strings1 Strings2 Strings3
#fx pad1 = highpass 250
#fx pad2 = lowpass 3000 @resonance 0
#bus brass = Brass1 Brass2 Brass3
#fx brass1 = highpass 150
#bus drop = DropChord1 DropChord2 DropChord3
#fx drop1 = highpass 60

// SCC waves (8). Sawtooth built from 1, 2, 3, 4, 6, 8, 11 and 16 harmonics.
#voice sccW1 = @scc{ bytes{0, 22, 43, 62, 79, 93, 103, 110, 112, 110, 103, 93, 79, 62, 43, 22, 0, -22, -43, -62, -79, -93, -103, -110, -112, -110, -103, -93, -79, -62, -43, -22} }
