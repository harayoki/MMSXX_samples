#voice pwmLead = @{pw16} @sccseq{pw16 2, pw15 2, pw14 2, pw13 2, pw12 2, pw11 2, pw10 2, pw9 2, pw8 2, pw7 2, pw6 2, pw5 2, pw6 2, pw7 2, pw8 2, pw9 2, pw10 2, pw11 2, pw12 2, pw13 2, pw14 2, pw15 2} @slide{-200, 5} @loop{sccseq 0}
// Sync lead (the non-gliding one). Each note raises the sync ratio from 1 to 5.
#voice syncLead = @{sy0} @sccseq{sy0 4 > sy1 4 > sy2 4 > sy3 4 > sy4 4 > sy5 4 > sy6} @slide{-200, 5}
// FM pluck. Modulation depth returns from 8 to 0 in 8 frames.
#voice fp0 = @scc{ bytes{0, -13, -26, 111, 67, 97, 59, -108, 112, -108, 59, 97, 67, 111, -26, -13, 0, 13, 26, -111, -67, -97, -59, 108, -112, 108, -59, -97, -67, -111, 26, 13} }
