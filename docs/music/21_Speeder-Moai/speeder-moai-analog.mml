#title ネメシス エクストラステージBGM アレンジ スピーダーモアイ (80's シンセアレンジ)
#about ネメシス(MSX)のエクストラステージBGMを、80年代のアナログシンセを使ったアレンジに。スピーダーバイク(アーケード)やワイワイワールド2のバージョンも参考にした。
#version 1.0.0


#looptimes 3

#fx swirl = phaser @rate 0.1 @depth 0.7 @freq 400 @feedback 0.5 @stages 6 @mix 0.5
#fx slap  = echo @l 16 @feedback 0.12 @mix 0.18
#fx sheet = plate 1.1 @predelay 18 @mix 0.16
#fx room  = plate 0.8 @predelay 10 @mix 0.10
#fx wide  = widener @width 0.6

#drum B = @{tr909::bassDrum(decay: 0.45)} v11 @o-3 @d+700 @ring BD
#drum S = @{tr909::snareDrum(snappy: 0.8)} v15 @o-1 @ring SD
#drum L = @{tr909::lowTom} v12 @o-2 @d+600 @ring LT
#drum M = @{tr909::midTom} v8 @o-2 @d+900 @ring MT
#drum D = @{tr909::midTom} v8 @o-2 @d+1000 @ring MT+
#drum T = @{tr909::hiTom} v9 @o-1 @ring HT
#drum E = @{tr909::hiTom} v9 @o-1 @d+200 @ring HT+
#drum R = @{tr909::rimShot} v12 @o-1 @d+900 @ring RS
#drum P = @{tr909::handClap} v12 @ring CP
#drum Y = @{tr909::crashCymbal} v11 @o-1 @d+800 @ring CY
#drum h = @{tr909::openHihat(decay: 0.43)} v8 @o-1 @d+800 @ring OH
#drum F = @{tr909::openHihat(decay: 0.75)} v8 @o-1 @d+800 @ring OH(長)
#drum H = @{tr909::closedHihat} v15 @o-1 @d+800 @ring CH
#drum c = @{tr909::closedHihat} v6 @o-1 @d+800 @ring CH(弱)
#drum o = @{tr909::openHihat(decay: 0.43)} v5 @o-1 @d+800 @ring OH(弱)

#accent S !! { v: -4 }

#ch 旋律
t131 v8 q7 l64 @{analog::syncLead} @p{0.26,0,1} @fxchain{slap}
r1
r2. r8 o6 d8
#label LOOP
c8 c8 o5 a+8 g8 o6 c8 c8 o5 a+8 g8
o6 c8 c8 o5 a+8 g8 o6 c8 c8 o5 a+8 g16 c16
o6 c16 o5 c16 o6 c16 o5 c16 a+16 c16 g16 c16 f16 c16 d+16 c16 d16 c16 d+16 o4 g+16
o5 d16 o4 g+16 o5 c16 o4 g+16 b16 g+16 o5 c16 o4 g+16 o5 d16 o4 g+16 o5 d+16 o4 g+16 o5 f16 o4 g+16 b16 o5 c8
o4 f16 o5 d8 o4 f16 o5 d+8 o4 f16 o5 f8 o4 f16 o5 d+16 o4 f16 o5 c16 o4 f16 o5 c8
o4 g16 o5 d8 o4 g16 o5 d+8 o4 g16 o5 f8 o4 g16 o5 d+16 o4 g16 o5 c16 o4 g16 o5 c8
o4 g16 o5 d8 o4 g16 o5 d+8 o4 g16 o5 f8 o4 g16 o5 d+16 o4 g16 o5 c16 o4 g16 o5 c8.
o4 g16 o5 d8 o4 g16 o5 d+8 o4 g16 o5 f16 o4 g16 o5 d+16 d16 c16 d8
