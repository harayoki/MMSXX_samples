#title ネメシス エクストラステージBGM アレンジ スピーダーモアイ (MSX編成)
#about シンセアレンジをさらにMSX音源でアレンジした物。スピーダーバイク(アーケード)やワイワイワールド2のバージョンも参考にしている。
#version 1.0.1

#voice fmChordA = @opll{ mod{ratio 3, depth 8, attack 15, decay 4, sustain 2, release 6, hold 1}, car{ratio 1, attack 13, decay 3, sustain 1, release 6, hold 1}, feedback 4 }
#voice fmChordB = @opll{ mod{ratio 1, depth 16, attack 15, decay 4, sustain 2, release 6, hold 1}, car{ratio 1, attack 13, decay 3, sustain 1, release 6, hold 1}, feedback 0 }
#voice fmChord1 = @{fmChordA} @opllseq{fmChordA 2 >1 fmChordB 10} @pitch{3, 7, 10, 12, 12, 10, 7, 3, -1, -4, -6, -6, -4, -1} @loop{pitch 0}
#voice fmChord2 = @{fmChordA} @opllseq{fmChordA 2 >1 fmChordB 10} @pitch{0, 4, 8, 10, 11, 10, 8, 4, 0, -4, -8, -10, -11, -10, -8, -4} @loop{pitch 0}
#voice fmChord3 = @{fmChordA} @opllseq{fmChordA 2 >1 fmChordB 10} @pitch{-3, 0, 3, 5, 6, 6, 5, 4, 1, -2, -4, -7, -10, -11, -12, -12, -11, -9, -6} @loop{pitch 0}

#voice fmStr1 = @{opll::organ} @pitch{6, 4, 5, 9, 7, 8, 11, 9, 10, 13, 10, 10, 13, 9, 9, 12, 8, 7, 9, 5, 5, 7, 2, 2, 3, -1, -1, 1, -3, -3, -1, -4, -4, -1, -4, -3, 0, -3, -1, 2, 0, 1, 5} @loop{pitch 0}
#voice fmStr2 = @{opll::organ} @pitch{2, 0, 1, 4, 2, 3, 6, 4, 4, 8, 5, 5, 8, 5, 5, 7, 4, 4, 6, 2, 2, 4, 0, 0, 2, -2, -3, -1, -5, -5, -3, -6, -6, -4, -7, -7, -4, -7, -6, -3, -6, -5, -2, -4, -3, 0, -2} @loop{pitch 0}
#voice fmStr3 = @{opll::organ} @pitch{-3, -5, -4, 0, -3, -1, 2, 0, 1, 4, 1, 2, 5, 2, 2, 5, 1, 1, 4, 0, 0, 2, -2, -3, -1, -5, -5, -3, -8, -8, -6, -10, -11, -9, -12, -13, -10, -14, -14, -11, -14, -14, -11, -14, -13, -9, -12, -11, -7, -10, -9, -5, -7} @loop{pitch 0}

#voice shimmer = @{sccSine} @sccseq{sccSine 48 >3 sccSaw 24 >3 sccSine 24} @loop{sccseq 0}
#voice shimmer2 = @{sccSaw} @sccseq{sccSaw 48 >3 sccSine 24 >3 sccSaw 24} @loop{sccseq 0}

#drum B = @{gamenotes::manbowDrumkit::kick} v13 @ring BD
#drum S = @{gamenotes::manbowDrumkit::snare} v14 @ring SD
#drum G = @{gamenotes::manbowDrumkit::snareBig} v14 @ring SD(強)
#drum R = @{gamenotes::manbowDrumkit::snareSoft} v11 @ring RS のかわり
#drum P = @{gamenotes::manbowDrumkit::snareSoft} v11 @ring CP のかわり
#drum Y = @{gamenotes::manbowDrumkit::crash} v11 @ring CY
#drum H = @{gamenotes::manbowDrumkit::hat} v10 @ring CH
#drum h = @{gamenotes::manbowDrumkit::hat} v8 @ring OH のかわり
#drum F = @{gamenotes::manbowDrumkit::hat} v8 @ring OH(長)のかわり
#drum c = @{gamenotes::manbowDrumkit::hatLight} v9 @ring CH(弱)
#drum o = @{gamenotes::manbowDrumkit::hatLight} v7 @ring OH(弱)
#drum L = @{ayTom} v13 @o-1 @d+700 @ring LT(o3 g)
#drum M = @{ayTom} v13 @ring MT(o4 c)
#drum D = @{ayTom} v13 @d+200 @ring MT+(o4 d)
#drum T = @{ayTom} v13 @d+700 @ring HT(o4 g)
#drum E = @{ayTom} v13 @d+900 @ring HT+(o4 a)
#drum U = @{gamenotes::sccSrmnd::scctam} v13 @o-1 @d+700 @ring LT(o3 g、SCC)
#drum W = @{gamenotes::sccSrmnd::scctam} v13 @ring MT(o4 c、SCC)
#drum X = @{gamenotes::sccSrmnd::scctam} v13 @d+700 @ring HT(o4 g、SCC)

#accent S !! { v: -4 }
#accent E ! { v: -4 }
#accent T ! { v: -4 }
#accent D ! { v: -4 }
#accent M ! { v: -4 }
#accent L ! { v: -4 }

