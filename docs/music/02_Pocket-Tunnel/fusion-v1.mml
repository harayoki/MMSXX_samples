/*
このMMLはJS側の音色・エンベロープ設定が必要です。
設定JS: https://harayoki.github.io/MMSXX_samples/music/02_Pocket-Tunnel/player.js

音色:
- ptChipPulse
エンベロープ:
- ptPercussive
*/

// この数値を直すと本編のループ回数が変わります（1以上）。
// イントロとエンディングは1回ずつ。全パート共通で、再生とWAVの両方に適用。
$LOOP_END = { 1 }

#title Pocket Tunnel
#about チップチューン アレンジ · 8BITゲーム感を強めたBGM
#arrangement チップチューン アレンジ
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)

// 使用音色：
//   @{ptChipPulse}   チップチューン アレンジの矩形波。強弱はMMLのvで指定。
//   @{noise:white}   標準ノイズによるドラム。
// @e{ptPercussive} は打楽器向けに減衰時間を調整。

#bundle ptChipVoice  = @{ptChipPulse} @e{ptPercussive}
#bundle ptNoiseVoice = @{noise:white} @e{ptPercussive}

