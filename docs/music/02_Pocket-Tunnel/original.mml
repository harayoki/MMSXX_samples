#voice ptDecay = @adsr{0.003, 70%, 0.32, 30%}

/*
このMMLにはJS側に残る設定があります。
設定JS: https://harayoki.github.io/MMSXX_samples/music/02_Pocket-Tunnel/player.js
残る定義: ptKick
*/

#voice ptHeld = @adsr{0.003, 0, 1, 0.004}
#voice ptLead = @{pulse(50)} @e{ptHeld}
#voice ptArp = @{saw} @e{ptHeld}
#voice ptBass = @{pulse(50)} @e{ptHeld}
#voice ptChord = @{pulse(50)} @e{ptHeld}
#voice ptHarmony = @{pulse(50)} @e{ptHeld}

// この数値を直すと本編のループ回数が変わります（1以上）。
// イントロとエンディングは1回ずつ。全パート共通で、再生とWAVの両方に適用。
$LOOP_END = { 1 }
#title Pocket Tunnel
#version 5.3
#about ノーマル · メニュー画面や始まりの街をイメージしたBGM
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)
// 使用音色：
//   @{ptLead}   メロディ用の矩形波。標準デチューン @d0 とエコー @s{3,8} をMMLで指定。
//   @{ptArp}   アルペジオ用ののこぎり波。
//   @{ptBass}   ノーマルのベース用矩形波。
//   @{ptChord}   ノーマルの和音用矩形波。持続と短い合いの手を切り替える。
//   @{ptHarmony}   メロディに重ねるハモリ用矩形波。エコーなし。
//   @{ptKick}   キック用2オペFM。125Hzから45Hzへ0.12秒で下降。
//   @{noise(white)}   スネアとハイハット用の標準ノイズ。a4／a6と発音長で鳴りを分ける。
// @e{ptHeld} は持続、@e{ptDecay} は音長に応じた減衰。
// エンベロープは音色定義の割合指定を使用。キックの調律はバンドルで指定。
#bundle ptLeadVoice    = @{ptLead} @e{ptHeld}
#bundle ptArpVoice     = @{ptArp} @e{ptDecay}
#bundle ptBassDecay    = @{ptBass} @e{ptDecay}
#bundle ptBassHeld     = @{ptBass} @e{ptHeld}
#bundle ptKickVoice    = @{ptKick} @e{ptDecay} @d-47
#bundle ptNoiseDecay   = @{noise(white)} @e{ptDecay}
#bundle ptChordHeld    = @{ptChord} @e{ptHeld}
#bundle ptHarmonyHeld  = @{ptHarmony} @e{ptHeld}
#bundle ptBaseVoice    = @{pulse(50)} @e{flat}
#ch メロディ
#role lead
// パート 1 — メロディ。
// イントロ
#label イントロ
t120 q8 @{ptLeadVoice} v9 @d0 @s{3,8} q5 o3 c16 o3 d16 o3 e16 o3 f16 o3 g16 o3 a16 o3 b16 o4 c16 o4
d16 o4 e16 o4 f16 o4 g16 o4 a16 o4 b16 o5 c16 r16
