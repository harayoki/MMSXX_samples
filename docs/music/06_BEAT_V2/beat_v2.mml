#title BEAT_V2
#version 2.8
#about 2オペのFM音源をかっこよくするテスト曲。80年代の雰囲気で。コード進行記述MMLとドラム専用MMLも活用してソースを短くしました。
#label 開始

// OPLL打楽器はo4c基準。0.28以降も従来の実際の音程を維持する。
#bundle beatBass1  = @{waveRamp} @e{piano} @s{8,2}
#bundle beatBass2  = @{triangle} @e{flat}
#bundle beatKick   = @{opllKick} @e{percussive},   @{noise} v11 @e{snap} @o-2
#bundle beatSnare  = @{opllSnare} @e{percussive},  @{noise} v10 @e{tap}
#bundle beatHatOff = @{noise(hiss)} @o+3 @e{snap},       @{opllCymbal} v4 q2 @e{snap}
#bundle beatHatOn  = @{noise(hiss)} @o+3 @e{percussive}, @{opllCymbal} v4 q2 @e{snap}
#bundle beatTom    = @{opllTom} @e{percussive}
#bundle beatTomLow = @{opllTom} @e{percussive}
#bundle beatBrassLow = @{opllHorn} @e{soft}
#bundle beatBrassMid = @{opllTrumpet} @e{soft}
#bundle beatBrassTop = @{opllTrumpet} @e{soft}
#chord  brass        = @{beatBrassLow} ブラス1, @{beatBrassMid} ブラス2, @{beatBrassTop} ブラス3

#ch ベース1
t152 q7 v13 l8 @{beatBass1} [o2 d a o3 d o2 a f a d o3 c o2 d a o3 d o2 a f a d o3 c o2 b- f o3 b- o2 f d f b- a
  o2 c g o3 c o2 g e g c b- o2 d a o3 d o2 a f a d o3 c o2 d a o3 d o2 a f a d o3 c o2 g d g d b- d g f o2 a e a
  e o3 c o2 e a g]2

#ch ベース2
t152 q8 v11 l1 @{beatBass2} [o2 d1 o2 d1 o2 b-1 o2 c1 o2 d1 o2 d1 o2 g1 o2 a1]2

#ch ドラム
#drum B = @{beatKick}       バスドラ
#drum S = @{beatSnare} v13  スネア
#drum H = @{beatHatOff} v10 ハイハットC
#drum h = @{beatHatOn}  v10 ハイハットO
#drum T = @{beatTom}    v12 タム
#drum t = @{beatTomLow} v12 タムLow
$a = { BH . h . SH . BH . BH . h . SH . h . }
$b = { BH . h . BSH . H . BHT T ht t BSHT . ht . }
$c = { BH . h . BSH . H . BHT T ht t BSHT S Sht S }
t152 q8 @{drums 16}{ v13 [$a | $a | $a | $b | $a | $a | $a | $c |]2
}

#ch ブラス
t152 q8 v11 l16 @{brass} [r1 r2 r4 r8 'o4a o4f o4d'16 'o4a o4f o4d'16 r1 r2 r4 'o4g o4e o4c'4 r1 r2 r4 r8 'o4a
  o4f o4d'16 'o4a o4f o4d'16 r2 'o5d o4b- o4g'4 'o5d o4b- o4g'4 'o5e o5c+ o4a'4 r4 r2]2



