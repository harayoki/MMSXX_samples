/*
JS側の音色・エンベロープ設定が必要です。
MMLだけをコピーしても元の音色・鳴り方は再現できません。
設定元: docs/music/04_Grassland-Trinity/player.js
独自音色: fieldLeadAttack, fieldTriangle, fieldHit2x14500, fieldHit2x8200, fieldHit2x5200, fieldHit0x29000, fieldHit0x18000, fieldHit0x11800。
独自エンベロープ: fieldEnv3x35357, fieldEnv3x80357, fieldEnv3x160714, fieldEnv3x115714, fieldEnv3x276429, fieldEnv2x53571, fieldEnv2x32000, fieldEnv2x17857, fieldEnv2x80357, fieldEnv2x40179。
以下はJS側の設定コードです。コメント内なのでMMLからは実行されません。
エンジン読込後、MMLを読み込む前に、利用先のJavaScriptへコピーしてください。

--- 設定コード（JavaScript） ---
const E = MMSXX.sound;
const tones = {
  fieldLeadAttack: { wave: 'pulse:50', env: 'flat', pitch: [120, 0] },
  fieldTriangle: { wave: 'wtNesTriangle', env: 'flat' },
  fieldHit2x14500: { wave: 'pulse:50', env: 'flat', pitch: [-21.740748211670333] },
  fieldHit2x8200: { wave: 'pulse:50', env: 'flat', pitch: [-8.569250687891364] },
  fieldHit2x5200: { wave: 'pulse:50', env: 'flat', pitch: [2.896005539719072] },
  fieldHit0x29000: { wave: 'pulse:12', env: 'flat', pitch: [-21.740748211670333] },
  fieldHit0x18000: { wave: 'pulse:12', env: 'flat', pitch: [-47.407940633981895] },
  fieldHit0x11800: { wave: 'pulse:12', env: 'flat', pitch: [21.540003004618065] },
};
const envelopes = {
  fieldEnv3x35357: { a: .004, d: .014142857142826416, s: .35, r: .12 },
  fieldEnv3x80357: { a: .004, d: .03214285714285714, s: .35, r: .12 },
  fieldEnv3x160714: { a: .004, d: .06428571428571428, s: .35, r: .12 },
  fieldEnv3x115714: { a: .004, d: .046285714285664886, s: .35, r: .12 },
  fieldEnv3x276429: { a: .004, d: .11057142857139582, s: .35, r: .12 },
  fieldEnv2x53571: { a: .002, d: .013392857142857142, s: 0, r: .05 },
  fieldEnv2x32000: { a: .002, d: .008, s: 0, r: .05 },
  fieldEnv2x17857: { a: .002, d: .004464285714285714, s: 0, r: .05 },
  fieldEnv2x80357: { a: .002, d: .020089285714285712, s: 0, r: .05 },
  fieldEnv2x40179: { a: .002, d: .010044642857142856, s: 0, r: .05 },
};
for (const [name, spec] of Object.entries(envelopes)) {
  E.registerEnvelope(name, {
    ...spec,
    note: 'Grassland Trinity converted envelope.',
    noteJa: '草原のトリニティの音長に合わせたエンベロープ。',
  });
}
for (const [name, spec] of Object.entries(tones)) {
  E.registerTone(name, {
    ...spec,
    note: 'Grassland Trinity custom tone.',
    noteJa: '草原のトリニティ専用音色。',
  });
}
*/

#title 草原のトリニティ
#about アクションRPGの草原BGMをイメージ。ファミコン4音に限定。
#ch メロディ
#role lead
t140 q5
#label Intro
r1 r2 r4 $tone q5 o4 f8 a8 q5
#label LOOP
#label 出発
q5 $tone o4 b-4 $tone q5 o4 b-16&o5 c16&d+16&e16&f2&f4 $p1 $p4 $tone o4 g+4 $p6 $tone o5 c+4&c+8 $p1 $p2 $p5
$tone o4 g+4 q5 $tone o4 f2&f4&f8 q5 $tone o4 f8 q5 $tone o4 f+2 q5 $tone o4 g+8 q5 $tone o4 b8 $p8 $p1 $tone o5
f2&f8 q5 $tone o4 g16 q5 $tone o4 g16 q5 $tone o5 e8 q5 $tone o5 d4 $p6 $tone o5 g4 q5 $tone o5 f1
#label 遠望
q5 $p9 $p9 $tone o5 b-2 q5 $tone o5 a8 q5 $tone o5 g8 q5 $tone o5 g+2 q5 $tone o5 f4 $p1 $p4 $tone o5 c+2&c+4
$p5 $p2 q5 $p4 $tone o4 a8 q5 $tone o4 f8 q5 $tone o4 a8 q5 $tone o5 c2&c8 q5 $p2 $p3 $tone o5 f+2 q5 $tone o5
f4&f8 q5 $tone o5 e8 q5 $p4 $tone o4 a8 $p6 $tone o4 b-2 q5 $tone o4 f+4 $p5 $p2 $p7
#label 飛翔
r4 q5 $tone o4 b4 $p8 q5 $tone o5 c+4 $p5 $tone o4 g+8 q5 $tone o4 f2 q5 $tone o4 g8 q5 $tone o4 g8 $p6 $tone o5
e2 $p7
#label OUTRO
$p3 $tone o5 d8 q5 $p4 $tone o5 f2&f4 $p1 $p4 $tone o4 g+2 $p3 $p2 $p1 $tone o5 c+4 $p3 $tone o5 f2 $p1 $p9
$tone o5 g+4 q5 $tone o5 f+4 $p1 $tone o5 f+8 q5 $tone o5 b2 q5 $tone o5 b-4&b-8 q5 $tone o5 g+8 q5 $tone o5 f4
$p1 $p2 q5 $tone o5 c+4 $p3 $tone o4 f+4 q5 $tone o5 d+4 $tone o5 d+8 $tone o5 d4&d8 $tone o4 b-4 r4

$tone={@{fieldLeadAttack} @e{flat} v7}
$p1={ q5 $tone o5 d+8 q5 }
$p2={ $tone o5 c+8 }
$p3={ q5 $tone o4 b-4 q5 }
$p4={ $tone o5 c8 q5 }
$p5={ q5 $tone o4 b-8 q5 }
$p6={ q5 $tone o5 c4 q5 }
$p7={ q5 $tone o5 c2&c4&c8 q5 $tone o4 a8 }
$p8={ q5 $tone o5 d+4&d+8 q5 $p2 }
$p9={ $tone o5 f8 q5 }

