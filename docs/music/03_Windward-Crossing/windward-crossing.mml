/*
JS側の音色・エンベロープ設定が必要です。
MMLだけをコピーしても元の音色・鳴り方は再現できません。
設定元: docs/music/03_Windward-Crossing/player.js
独自音色: wcFieldLead, wcBattleLead, wcCounterLead, wcFieldCounter, wcBattleBass, wcBass, wcArp, wcKick。
独自エンベロープ: wcLeadEnv, wcPluckEnv, wcDrumEnv, wcBattleBassEnv。
以下はJS側の設定コードです。コメント内なのでMMLからは実行されません。
エンジン読込後、MMLを読み込む前に、利用先のJavaScriptへコピーしてください。

--- 設定コード（JavaScript） ---
const E = MMSXX.sound;
E.registerEnvelope('wcLeadEnv', {
  a: .004, d: .09, s: .68, r: .012,
  note: 'Windward Crossing lead envelope.',
  noteJa: 'Windward Crossingのリード用エンベロープ。',
});
E.registerEnvelope('wcPluckEnv', {
  a: .003, d: .08, s: .18, r: .008,
  note: 'Windward Crossing pluck envelope.',
  noteJa: 'Windward Crossingの短い伴奏用エンベロープ。',
});
E.registerEnvelope('wcDrumEnv', {
  a: .001, d: .045, s: 0, r: .004,
  note: 'Windward Crossing drum envelope.',
  noteJa: 'Windward Crossingの打楽器用エンベロープ。',
});
E.registerEnvelope('wcBattleBassEnv', {
  a: .003, d: .055, s: .65, r: .01,
  note: 'Windward Crossing battle bass envelope.',
  noteJa: 'Windward Crossingの戦闘ベース用エンベロープ。',
});
E.registerTone('wcFieldLead', {
  wave: 'wtNesTriangle', env: 'wcLeadEnv',
  note: 'Field lead.', noteJa: 'フィールド用リード。',
});
E.registerTone('wcBattleLead', {
  wave: 'pulse:25', env: 'wcLeadEnv',
  note: 'Battle lead.', noteJa: '戦闘用リード。',
});
E.registerTone('wcCounterLead', {
  wave: 'pulse:12.5', env: 'wcLeadEnv',
  note: 'Battle counter melody.', noteJa: '戦闘用副旋律。',
});
E.registerTone('wcFieldCounter', {
  wave: 'pulse:50', env: 'wcLeadEnv',
  note: 'Soft field counter melody.', noteJa: '柔らかいフィールド用副旋律。',
});
E.registerTone('wcBattleBass', {
  wave: 'pulse:50', env: 'wcBattleBassEnv',
  note: 'Battle bass.', noteJa: '戦闘用ベース。',
});
E.registerTone('wcBass', {
  wave: 'wtNesTriangle', env: 'wcPluckEnv',
  note: 'Field bass.', noteJa: 'フィールド用ベース。',
});
E.registerTone('wcArp', {
  wave: 'pulse:50', env: 'wcPluckEnv',
  note: 'Short accompaniment.', noteJa: '短い伴奏音。',
});
E.registerFM('wcKick', {
  ratio: 1, depth: 0, attack: .002, decay: .085, sustain: 0,
  drop: 1.8, dropTime: .075,
}, {
  role: 'perc',
  note: 'Windward Crossing kick.',
  noteJa: 'Windward Crossingのキック。',
});
*/

#title 風渡りの境界 (RPG組曲)
#version 1.8
#about 王道RPGを意識した組曲。フィールド、エンカウント、戦闘（A/B/C）、勝利、敗北を連続再生。
#arrangement RPG Suite — 風渡りの境界
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)
// イントロ → 草原×2 → エンカウント → 有利×1 → 不利×2 → 大ピンチ×2
// → 勝利 → 草原4小節 → エンカウント → 不利×2 → 大ピンチ×2 → 敗北
// 4声。戦闘はベース専用、副旋律とドラムを分離。
// @{wcFieldLead} 草原・イントロ・敗北の三角波メロディー。
// @{wcBattleLead} 戦闘・勝利の矩形波メロディーと副旋律。
// @{wcCounterLead} 戦闘副旋律用の細い矩形波。ベースとの音域重複を避ける。
// @{wcFieldCounter} フィールド副旋律用の柔らかい矩形波。
// @{wcBass} 草原などの短く減衰する三角波ベース。
// @{wcBattleBass} 戦闘用の矩形波ベース。大ピンチは8分3連符（l12相当）。
// @{wcArp} 草原などの隙間に入る矩形波アルペジオ。
// @{wcKick} ピッチが急降下する標準FMのキック。
// @{noise:white} 打楽器。@e{wcDrumEnv}で短く減衰する。
// 音色はplayer.jsの標準APIで登録。@m1は標準ビブラート。

// 曲内で使う音色セット。音色にエコーやエンベロープを着せ、宣言をここへ集約。
// 複数セットを同時に重ねる場合は、#bundle の右辺へカンマ区切りで並べる。
#bundle fieldLeadEcho = @{wcFieldLead} @s{8,8}
#bundle fieldLeadDry  = @{wcFieldLead} @s0
#bundle battleLead    = @{wcBattleLead} @s0
#bundle counterLead   = @{wcCounterLead} @s{8,8} @o+1
#bundle fieldCounter  = @{wcFieldCounter} @s{8,8}
#bundle fieldBass     = @{wcBass} @s0
#bundle battleBass    = @{wcBattleBass} @s0
#bundle fieldArp      = @{wcArp} @s0
#bundle kick          = @{wcKick} @s0
#bundle drumNoise     = @{noise:white} @e{wcDrumEnv} @s0

// 再生設定：ここだけ編集すれば全4パートへ反映されます。
// 回数は 0＝省略、1以上＝指定回数です。
// 単独再生は、目的の曲以外をすべて0にしてください。
$INTRO_COUNT = { 1 } // イントロ
$FIELD_COUNT = { 2 } // 草原
$ENCOUNTER_COUNT = { 1 } // エンカウント
$GOOD_COUNT = { 1 } // 通常戦闘（有利）
$BAD_COUNT = { 2 } // 不利
$CRISIS_COUNT = { 2 } // 大ピンチ
$WIN_COUNT = { 1 } // 勝利
$FIELD_SHORT_COUNT = { 1 } // 短い草原
$ENCOUNTER_AGAIN_COUNT = { 1 } // 2度目のエンカウント
$BAD_AGAIN_COUNT = { 2 } // 2度目の不利
$CRISIS_AGAIN_COUNT = { 2 } // 2度目の大ピンチ
$LOSE_COUNT = { 1 } // 敗北

// 演奏順も全パート共通。順番を変える場合はこの定義を編集します。
$ORDER = {
#label イントロ
[$intro]$INTRO_COUNT
#label フィールド
[$field]$FIELD_COUNT
#label エンカウント
[$encounter]$ENCOUNTER_COUNT
#label 戦闘 A
[$good]$GOOD_COUNT
#label 戦闘 B
[$bad]$BAD_COUNT
#label 戦闘 C
[$crisis]$CRISIS_COUNT
#label 勝利
[$win]$WIN_COUNT
#label フィールド（後半）
[$fieldShort]$FIELD_SHORT_COUNT
#label エンカウント（後半）
[$encounter]$ENCOUNTER_AGAIN_COUNT
#label 戦闘 B（後半）
[$bad]$BAD_AGAIN_COUNT
#label 戦闘 C（後半）
[$crisis]$CRISIS_AGAIN_COUNT
#label 敗北
[$lose]$LOSE_COUNT
}

// 各曲の先頭で状態を初期化。その後、曲固有の設定を指定します。
$RESET = { o4 l4 t120 v10 q7 p3 @{pulse:50} @e{flat} @d0 @m0 @s0 @o0 }

#ch 主旋律
#role lead
// 音色・テンポ・音量の共通設定。音符は下のフレーズ／各曲に記述。
$sound1 = { @m0 t112 @{fieldLeadEcho} @m1 v10 q5 o5 }
$sound2 = { @m0 t152 @{battleLead} @m1 v7 q6 o4 }
$sound3 = { @m0 t152 @{battleLead} @m1 v7 q6 o5 }
$sound4 = { @m0 t152 @{battleLead} @m1 v9 q6 o5 }
$sound5 = { @m0 t152 @{battleLead} @m1 v8 q7 o5 }
$sound6 = { @m0 t132 @{battleLead} @m1 v9 q6 o5 }
$sound7 = { @m0 t96 @{fieldLeadDry} @m1 v9 q6 o5 }
$sound8 = { @m0 t96 @{fieldLeadDry} @m1 v9 q6 o4 }
// 複数箇所で使うフレーズ。
$phrase1 = { $sound1 f+8 a8 d4 r2 }
$phrase2 = { $sound1 g8 b8 a4 f+8 e8 d4 }
$phrase3 = { $sound1 f+8 a8 b4 a8 f+8 d8 r8 }
$phrase4 = { $sound1 e4 c+8 e8 a4 r4 }
$phrase5 = { $sound2 d8 f+16 a16 o5 d4 o4 a8 o5 d8 e8 f+8 }
$phrase6 = { $sound3 e4 c+8 o4 a8 o5 c+8 e8 a8 r8 }
$phrase7 = { $sound2 g8 b16 o5 d16 g4 f+8 e8 d4 }
$phrase8 = { $sound3 e8 c+8 o4 a4 o5 c+8 e8 a8 r8 }
$phrase9 = { $sound2 f+8 a16 o5 d16 f+4 e8 d8 o4 a4 }
// crisis: 8小節
$crisis = {
$RESET $sound4 r8 a8 o6 d4 o5 a8 r8 f8 e8 $sound4 d8. f16 a8 d8 r8 a8 f4 $sound4 r8 f8 b-4 f8 r8 d8 f8 $sound4
  b-8. a16 f8 d8 r8 f8 b-4 $sound4 r8 g8 o6 d4 o5 b-8 r8 a8 g8 $sound4 e8. g16 b-8 g8 r8 e8 c+4 $sound4 r8 e8 a4
  g8 r8 e8 c+8 $sound4 a8. g16 e8 c+8 r8 e8 a4
}
// intro: 2小節
$intro = {
$RESET @m0 t112 @{fieldLeadDry} @m1 v9 q6 o4 d8 f+8 a8 o5 d8 f+4 e8 d8 @m0 t112 @{fieldLeadDry} @m1 v9 q6 o5 c+4
  o4 a8 b8 o5 c+8 e8 a8 r8
}
// field: 8小節
$field = {
$RESET $phrase1 $phrase2 $phrase3 $phrase4 $sound1 a8 f+8 e8 d8 f+4 a4 $sound1 b8 a8 g4 d8 e8 g4 $sound1 f+4 d8
  f+8 b8 a8 f+4 $sound1 e8 c+8 o4 b8 a8 o5 c+8 e8 a8 r8 @s0
}
// encounter: 2小節
$encounter = {
$RESET @m0 t152 @{battleLead} @m1 v9 q6 o4 b-16 c+16 e16 g16 b-16 o5 c+16 e16 g16 b-8 g8 e8 c+8 $sound4 e16 g16
  a16 b-16 a8 e8 c+4 o4 a8 r8
}
// good: 16小節（休符を活用）
$good = {
$RESET $sound2 d8 f+16 a16 o5 d4 o4 a8 o5 d8 e8 f+16 r16 $sound3 e4 c+8 o4 a8 o5 c+8 e8 a8 r8 $sound2 g8 b16 o5
  d16 g4 f+8 e8 d8 r8 $sound3 e8 c+8 o4 a4 o5 c+8 e8 a8 r8 $sound2 f+8 a16 o5 d16 f+4 e8 d8 o4 a8 r8 $sound3 e4
  c+8 o4 a8 o5 c+8 e8 a8 r8 $sound2 g8 b16 o5 d16 g4 d8 e8 g8 r8 $sound3 e8 c+8 o4 a8 o5 c+8 e4 c+8 r8 $sound3
  f+4 e8 d8 o4 b4 o5 d8 r8 $sound3 e8 d8 o4 b8 a8 g4 b4 $sound2 a4 b8 o5 c+8 e4 c+8 r8 $sound3 d4 o4 b8 a8 f+4
  a4 $sound2 g8 b8 o5 d4 e8 d8 o4 b8 r8 $sound3 e4 c+8 o4 a8 o5 g8 e8 c+4 $sound2 f+8 a8 o5 d8 e8 f+4 e8 d16 r16
  $sound3 f+8 e8 d4 o4 a4 o5 d8 r8
}
// bad: 8小節
$bad = {
$RESET $sound5 a4. f8 e8 f8 d4 $sound5 g4. f8 e-4 g8 b-8 $sound5 g4 e8 c+8 e4 g4 $sound5 e4. c+8 o4 b-8 a8 o5
  c+4 $sound5 d4. g8 f8 d8 o4 b-4 $sound5 e-4 g8 b-8 g4 e-4 $sound5 e4. g8 e8 c+8 o4 b-4 $sound5 c+4 e8 g8 e4
  c+8 r8
}
// win: 4小節
$win = {
$RESET $sound6 d8 f+16 a16 o6 d4 o5 a8 b8 o6 d4 @m0 t132 @{battleLead} @m1 v9 q6 o6 d8 o5 b8 g4 a8 b8 o6 d4
  $sound6 c+8 e8 a4 g8 e8 c+4 $sound6 d2 r2
}
// lose: 4小節
$lose = {
$RESET $sound7 a4 f4 e4 d4 $sound7 e-4 o4 b-4 g2 $sound8 a4 o5 c+4 e4 c+4 $sound8 d2 r2
}
$fieldShort = {
$RESET $phrase1 $phrase2 $phrase3 $phrase4 @s0
}
// 演奏順は冒頭の $ORDER と回数で指定します。
$ORDER

#ch ベース
#role bass
// 音色・テンポ・音量の共通設定。音符は下のフレーズ／各曲に記述。
$sound1 = { @m0 t112 @{fieldBass} v15 q6 o1 }
$sound2 = { @m0 t152 @{fieldBass} v13 q6 o1 }
$sound3 = { @m0 t132 @{fieldBass} v13 q6 o1 }
$sound4 = { @m0 t96 @{fieldBass} v13 q6 o2 }
// 複数箇所で使うフレーズ。
$phrase1 = { @m0 t152 @{battleBass} q5 v10 o3 d12 v8 o4 d12 v8 o3 a12 v10 o3 d12 v8 o4 d12 v8 o3 a12 v10 o3 d12
  v8 o4 d12 v8 o3 a12 v10 o4 d12 v8 o3 a12 v8 o3 d12 }
$phrase2 = { @m0 t152 @{battleBass} q5 v10 o2 a+12 v8 o3 a+12 v8 o3 f12 v10 o2 a+12 v8 o3 a+12 v8 o3 f12 v10 o2
  a+12 v8 o3 a+12 v8 o3 f12 v10 o3 a+12 v8 o3 f12 v8 o2 a+12 }
$phrase3 = { @m0 t152 @{battleBass} q5 v10 o2 a12 v8 o3 a12 v8 o3 e12 v10 o2 a12 v8 o3 a12 v8 o3 e12 v10 o2 a12
  v8 o3 a12 v8 o3 e12 v10 o3 a12 v8 o3 e12 v8 o2 a12 }
$phrase4 = { @m0 t112 @{fieldBass} v15 q6 o2 d8 r8 @{fieldArp} v7 q5 o4 d16 o4 f+16 o4 a16 o5 d16 @{fieldBass}
  v14 q6 o2 a8 r8 @{fieldArp} v7 q5 o5 d16 o4 a16 o4 f+16 o4 d16 }
$phrase5 = { $sound1 g8 r8 @{fieldArp} v7 q5 o3 b16 o4 d16 o4 g16 o4 b16 @{fieldBass} v14 q6 o2 d8 r8
  @{fieldArp} v7 q5 o4 b16 o4 g16 o4 d16 o3 b16 }
$phrase6 = { $sound1 b8 r8 @{fieldArp} v7 q5 o3 b16 o4 d16 o4 f+16 o4 b16 @{fieldBass} v14 q6 o2 f+8 r8
  @{fieldArp} v7 q5 o4 b16 o4 f+16 o4 d16 o3 b16 }
$phrase7 = { $sound1 a8 r8 @{fieldArp} v7 q5 o4 c+16 o4 e16 o4 a16 o5 c+16 @{fieldBass} v14 q6 o2 e8 r8
  @{fieldArp} v7 q5 o5 c+16 o4 a16 o4 e16 o4 c+16 }
$phrase8 = { @m0 t152 @{battleBass} q6 v8 o3 d8 v6 o3 d8 v8 o3 d8 v6 o3 a8 v8 o3 d8 v6 o3 d8 v8 o4 d8 v6 o3 a8 }
$phrase9 = { @m0 t152 @{battleBass} q6 v8 o2 a8 v6 o2 a8 v8 o2 a8 v6 o3 e8 v8 o2 a8 v6 o2 a8 v8 o3 a8 v6 o3 e8 }
$phrase10 = { @m0 t152 @{battleBass} q6 v8 o2 g8 v6 o2 g8 v8 o2 g8 v6 o3 d8 v8 o2 g8 v6 o2 g8 v8 o3 g8 v6 o3 d8
  }
$phrase11 = { @m0 t152 @{battleBass} q6 v8 o2 b8 v6 o2 b8 v8 o2 b8 v6 o3 f+8 v8 o2 b8 v6 o2 b8 v8 o3 b8 v6 o3
  f+8 }
$phrase12 = { @m0 t152 @{battleBass} q6 v10 o3 d+8 v8 o3 d+8 v10 o3 d+8 v8 o3 a+8 v10 o3 d+8 v8 o3 d+8 v10 o4
  d+8 v8 o3 a+8 }
$phrase13 = { @m0 t152 @{battleBass} q6 v10 o2 a+8 v8 o2 a+8 v10 o2 a+8 v8 o3 e8 v10 o2 a+8 v8 o2 a+8 v10 o3 a+8
  v8 o3 e8 }
$phrase14 = { @m0 t152 @{battleBass} q6 v10 o2 a8 v8 o2 a8 v10 o2 a8 v8 o3 e8 v10 o2 a8 v8 o2 a8 v10 o3 a8 v8 o3
  e8 }
// crisis: 8小節
$crisis = {
$RESET $phrase1 $phrase1 $phrase2 $phrase2 @m0 t152 @{battleBass} q5 v10 o2 g12 v8 o3 g12 v8 o3 d12 v10 o2 g12
  v8 o3 g12 v8 o3 d12 v10 o2 g12 v8 o3 g12 v8 o3 d12 v10 o3 g12 v8 o3 d12 v8 o2 g12 @m0 t152 @{battleBass} q5
  v10 o2 a+12 v8 o3 a+12 v8 o3 e12 v10 o2 a+12 v8 o3 a+12 v8 o3 e12 v10 o2 a+12 v8 o3 a+12 v8 o3 e12 v10 o3 a+12
  v8 o3 e12 v8 o2 a+12 $phrase3 $phrase3
}
// intro: 2小節
$intro = {
$RESET @m0 t112 @{fieldBass} v13 q6 o2 d8 r8 @{fieldArp} v5 q5 o4 d16 o4 f+16 o4 a16 o5 d16 @{fieldBass} v12 q6
  o2 a8 r8 @{fieldArp} v5 q5 o5 d16 o4 a16 o4 f+16 o4 d16 @m0 t112 @{fieldBass} v13 q6 o1 a8 r8 @{fieldArp} v5
  q5 o4 c+16 o4 e16 o4 a16 o5 c+16 @{fieldBass} v12 q6 o2 e8 r8 @{fieldArp} v5 q5 o5 c+16 o4 a16 o4 e16 o4 c+16
}
// field: 8小節
$field = {
$RESET $phrase4 $phrase5 $phrase6 $phrase7 $phrase4 $phrase5 $phrase6 $phrase7
}
// encounter: 2小節
$encounter = {
$RESET $sound2 a+8 r8 @{fieldArp} v5 q5 o3 a+16 o4 c+16 o4 e16 o4 g16 @{fieldBass} v12 q6 o2 f8 r8 @{fieldArp}
  v5 q5 o4 g16 o4 e16 o4 c+16 o3 a+16 $sound2 a8 r8 @{fieldArp} v5 q5 o4 c+16 o4 e16 o4 g16 o4 a16 @{fieldBass}
  v12 q6 o2 e8 r8 @{fieldArp} v5 q5 o4 a16 o4 g16 o4 e16 o4 c+16
}
// good: 16小節（休符を活用）
$good = {
$RESET $phrase8 $phrase9 $phrase10 $phrase9 $phrase8 $phrase9 $phrase10 $phrase9 $phrase11 $phrase10 $phrase9
  $phrase11 $phrase10 $phrase9 $phrase8 @m0 t152 @{battleBass} q6 v8 o3 d4 v6 a4 v8 d4 v6 d4
}
// bad: 8小節
$bad = {
$RESET @m0 t152 @{battleBass} q6 v10 o3 d8 v8 o3 d8 v10 o3 d8 v8 o3 a8 v10 o3 d8 v8 o3 d8 v10 o4 d8 v8 o3 a8
  $phrase12 $phrase13 $phrase14 @m0 t152 @{battleBass} q6 v10 o2 g8 v8 o2 g8 v10 o2 g8 v8 o3 d8 v10 o2 g8 v8 o2
  g8 v10 o3 g8 v8 o3 d8 $phrase12 $phrase13 $phrase14
}
// win: 4小節
$win = {
$RESET @m0 t132 @{fieldBass} v13 q6 o2 d8 r8 @{fieldArp} v5 q5 o4 d16 o4 f+16 o4 a16 o5 d16 @{fieldBass} v12 q6
  o2 a8 r8 @{fieldArp} v5 q5 o5 d16 o4 a16 o4 f+16 o4 d16 $sound3 g8 r8 @{fieldArp} v5 q5 o3 b16 o4 d16 o4 g16
  o4 b16 @{fieldBass} v12 q6 o2 d8 r8 @{fieldArp} v5 q5 o4 b16 o4 g16 o4 d16 o3 b16 $sound3 a8 r8 @{fieldArp} v5
  q5 o4 c+16 o4 e16 o4 a16 o5 c+16 @{fieldBass} v12 q6 o2 e8 r8 @{fieldArp} v5 q5 o5 c+16 o4 a16 o4 e16 o4 c+16
  @m0 t132 @{fieldBass} v12 q6 o2 d2 r2
}
// lose: 4小節
$lose = {
$RESET $sound4 d8 r8 @{fieldArp} v5 q5 o4 d16 o4 f16 o4 a16 o5 d16 @{fieldBass} v12 q6 o2 a8 r8 @{fieldArp} v5
  q5 o5 d16 o4 a16 o4 f16 o4 d16 $sound4 d+8 r8 @{fieldArp} v5 q5 o4 d+16 o4 g16 o4 a+16 o5 d+16 @{fieldBass}
  v12 q6 o2 a+8 r8 @{fieldArp} v5 q5 o5 d+16 o4 a+16 o4 g16 o4 d+16 @m0 t96 @{fieldBass} v13 q6 o1 a8 r8
  @{fieldArp} v5 q5 o4 c+16 o4 e16 o4 g16 o4 a16 @{fieldBass} v12 q6 o2 e8 r8 @{fieldArp} v5 q5 o4 a16 o4 g16 o4
  e16 o4 c+16 @m0 t96 @{fieldBass} v12 q6 o2 d2 r2
}
$fieldShort = {
$RESET $phrase4 $phrase5 $phrase6 $phrase7
}
// 演奏順は冒頭の $ORDER と回数で指定します。
$ORDER

#ch 副旋律
#role counter
// 打楽器と同時に鳴らない位置だけを担当します。フィールドでは主旋律の隙間を薄く補完します。
$battle = { @m0 t152 q6 @{counterLead} v4 }
$fieldCounter = { @m0 t112 q5 @{fieldCounter} v5 o4 }
$fieldReply1 = { $fieldCounter r2 r8 a8 r8 a8 }
$fieldReply2 = { $fieldCounter r8 b8 r8 o5 d8 r2 }
$fieldReply3 = { $fieldCounter r2. r8 o4 d8 }
$fieldReply4 = { $fieldCounter r2 r8 c+8 r4 }
$fieldReply5 = { $fieldCounter r2 r8 a8 r8 f+8 }
$fieldReply6 = { $fieldCounter r8 b8 r8 o5 d8 r2 }
$fieldReply7 = { $fieldCounter r2 r8 d8 r8 c+8 }
$fieldReply8 = { $fieldCounter r2. r8 a8 }
$fullFD = { $battle o4 [r16 f16]4 [r16 d16]4 }
$fullAG = { $battle o3 [r16 a+16]4 [r16 g16]4 }
$fullCsAs = { $battle o4 [r16 c+16]4 o3 [r16 a+16]4 }
$fullCsA = { $battle o4 [r16 c+16]4 o3 [r16 a16]4 }
$fullDsAs = { $battle o4 [r16 d+16]4 o3 [r16 a+16]4 }
$fullFsD = { $battle o4 [r16 f+16]4 [r16 d16]4 }
$fullECs = { $battle o4 [r16 e16]4 [r16 c+16]4 }
$fullDB = { $battle o4 [r16 d16]4 o3 [r16 b16]4 }
$halfFsD = { $battle o4 [r16 f+16 r8]2 [r16 d16 r8]2 }
$halfECs = { $battle o4 [r16 e16 r8]2 [r16 c+16 r8]2 }
$halfDB = { $battle o4 [r16 d16 r8]2 o3 [r16 b16 r8]2 }

$intro = { $RESET t112 [r1]2 }
$field = {
$RESET $fieldReply1 $fieldReply2 $fieldReply3 $fieldReply4 $fieldReply5 $fieldReply6 $fieldReply7 $fieldReply8
}
$encounter = { $RESET t152 [r1]2 }
$good = {
$RESET $halfFsD $halfECs $halfDB $halfECs $halfFsD $halfECs $halfDB $halfECs $halfDB $halfDB $halfECs $halfDB
  $halfDB $halfECs $halfFsD $halfECs
}
$bad = {
$RESET $fullFD $fullDsAs $fullCsAs $fullCsA $fullAG $fullAG $fullCsAs $fullCsA
}
$crisis = {
$RESET $fullFD $fullFD $fullFD $fullFD $fullAG $fullCsAs $fullCsA $fullCsA
}
$win = { $RESET t132 [r1]4 }
$lose = { $RESET t96 [r1]4 }
$fieldShort = {
$RESET $fieldReply1 $fieldReply2 $fieldReply3 $fieldReply4
}
// 演奏順は冒頭の $ORDER と回数で指定します。
$ORDER

#ch ドラム
#role perc
// 副旋律の休符位置だけを担当します。
$battleDrums = {
@m0 t152 q6 @{kick} v10 o2 c16 r16 @{drumNoise} v3 o6 a16 r16 @{drumNoise} v6 o4 a16 r16 @{drumNoise} v3 o6 a16
  r16 @{kick} v9 o2 c16 r16 @{drumNoise} v3 o6 a16 r16 @{drumNoise} v6 o4 a16 r16 @{drumNoise} v3 o6 a16 r16
}
$fieldDrums = { @m0 t112 @{drumNoise} v2 q2 o6 a8 r8 a8 r8 a8 r8 a8 r8 }
$encounterDrums = {
@m0 t152 @{kick} v10 q3 o2 c8 @{drumNoise} v3 o6 a8 v6 o4 a8 v3 o6 a8 @{kick} v9 o2 c8 @{drumNoise} v3 o6 a8 v6
  o4 a8 v3 o6 a8
}
$winDrums = {
@m0 t132 @{kick} v10 q3 o2 c8 @{drumNoise} v3 o6 a8 v6 o4 a8 v3 o6 a8 @{kick} v9 o2 c8 @{drumNoise} v3 o6 a8 v6
  o4 a8 v3 o6 a8
}
$loseDrums = { @m0 t96 @{drumNoise} v2 q2 o6 a8 r8 a8 r8 a8 r8 a8 r8 }
$endingKick132 = { @m0 t132 @{kick} v8 q3 o2 c8 r8 r2. }
$endingKick96 = { @m0 t96 @{kick} v8 q3 o2 c8 r8 r2. }

$intro = { $RESET [$fieldDrums]2 }
$field = { $RESET [$fieldDrums]8 }
$encounter = { $RESET [$encounterDrums]2 }
$good = { $RESET [$battleDrums]16 }
$bad = { $RESET [$battleDrums]8 }
$crisis = { $RESET [$battleDrums]8 }
$win = { $RESET [$winDrums]3 $endingKick132 }
$lose = { $RESET [$loseDrums]3 $endingKick96 }
$fieldShort = { $RESET [$fieldDrums]4 }
// 演奏順は冒頭の $ORDER と回数で指定します。
$ORDER
