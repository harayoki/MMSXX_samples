// 元曲と同じフィールド用リードと8分音符間隔のセルフエコー。
#bundle fieldLeadEcho = @{wcFieldLead} @s8

#ch 主旋律
#role lead
#label フィールド
@m0 t112 @{fieldLeadEcho} @m1 v10 q5 o5
f+8 a8 d4 r2
g8 b8 a4 f+8 e8 d4
f+8 a8 b4 a8 f+8 d8 r8
e4 c+8 e8 a4 r4
a8 f+8 e8 d8 f+4 a4
b8 a8 g4 d8 e8 g4
f+4 d8 f+8 b8 a8 f+4
e8 c+8 o4 b8 a8 o5 c+8 e8 a8 r8
@s0
