#voice wcLeadEnv = @adsr{0.004, 0.09, 0.68, 0.012}
#voice wcFieldLead = @{nesTriangle} @e{wcLeadEnv}

#title Windward Crossing — CH1 Field
#version 1.3
// 全体音量はMMLのvで指定（上限15）。JSによる曲別増幅は使わない。
#about Windward CrossingのCH1（主旋律）のフィールド部分だけを再生。
#arrangement RPG Suite — 風渡りの境界
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)

// 元曲と同じフィールド用三角波リード。三角波は音量を変えられないためエコーなし。
#bundle fieldLeadDry = @{wcFieldLead} @s0

#ch 主旋律
#role lead
#label フィールド
@m0 t112 @{fieldLeadDry} @m1 v15 q5 o5 f+8 a8 d4 r2 g8 b8 a4 f+8 e8 d4 f+8 a8 b4 a8 f+8 d8 r8 e4 c+8 e8 a4 r4
  a8 f+8 e8 d8 f+4 a4 b8 a8 g4 d8 e8 g4 f+4 d8 f+8 b8 a8 f+4 e8 c+8 o4 b8 a8 o5 c+8 e8 a8 r8 @s0


