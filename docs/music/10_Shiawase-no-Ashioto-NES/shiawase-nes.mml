// シアワセノアシオト(NES アレンジ)。ファミコンの 2A03 の 4 声
// もとの曲はサイン波 4 声(samples/mml_experiments/03_shiawase_no_ashioto/)。
// 4 パートを、矩形波 2 本・三角波・ノイズに詰め直した。
//   矩形波 1  主役の線。1 周目 メロディ、2 周目 対旋律の歌う線、3 周目 メロディ(後ろ)
//   矩形波 2  伴奏。1 周目 対旋律(ガイドトーン)、2 周目 アルペジオ、
//             3 周目 1 オクターブ下のアルペジオ。フレーズの切れ目に小さいぴろろ(駆け下り)
//   三角波    ベース。3 周目は 1 オクターブ上の主役
//   ノイズ    スネアだけ。1 周目の後半から少しずつ入ってくる
// やさしさを残すため、矩形波はどちらも柔らかいエンベロープで、音量を控えめにする。
// 三角波には音量が無いので、後奏は音を間引いて終わる
// | Gm7 | C7 | Fmaj7 | Dm7 | Gm7 | C7 | Am7 D7 | Gm7 C7 |
// | Bbmaj7 | Eb7 | Am7 | D7 | Gm7 | C7 | F6 | C7 |

#title シアワセノアシオト NES（TEST）
#about 本編3周でメロディ、対旋律、ベースが主役を交代し、後奏でフェードアウトするNES 4声アレンジ。
#looptimes 1

#ch 矩形波 1
t108 l8 @{nesPulse(50)} @e{soft} q7 v11 o5 @fade{15,0}
#label LOOP
r4 d10. f10 a4 g10. f10 | e2. r10. c10 | a4&a10. g10 a4 >c4< | a2 r4 f10. g10 |
b-4&b-10. a10 g4 f10. d10 | e4 g10. b-10 >d4 c4< | >c4< a4 f+4 a4 | g2 e4 r4 |
f4&f10. d10 f4 a4 | g2 f4 e-4 | e4&e10. c10 e4 g4 | f+2 a4 >c4< |
b-4 a10. g10 f4 d4 | e4 g4 b-4 g4 | f1 | r2 r4 c10. e10 |
o4 f2 g10. a10 b-4 | o4 >c4< b-4 g10. f10 e4 | o4 e2. f10. g10 | o4 a4 f4 c4 e4 |
o4 f2 d10. f10 a4 | o4 b-2 a10. g10 e4 | o4 g4 e4 f+4 a4 | o4 f4 d4 e4 g4 |
o4 a2 f10. d10 f4 | o4 g4 b-4 >d-2< | o4 >c2< a10. g10 e4 | o4 f+4 a4 >c4< a4 |
@fade{9,16,g2} o4 b-2 a10. g10 f4 | o4 e4 g4 b-2 | o4 a2. r4 | o4 r2 g10. b-10 >c4< o5 |
r4 d10. f10 a4 g10. f10 | e2. r10. c10 | a4&a10. g10 a4 >c4< | a2 r4 f10. g10 |
b-4&b-10. a10 g4 f10. d10 | e4 g10. b-10 >d4 c4< | >c4< a4 f+4 a4 | g2 e4 r4 |
f4&f10. d10 f4 a4 | g2 f4 e-4 | e4&e10. c10 e4 g4 | f+2 a4 >c4< |
@fade{15,16,g0.5} b-4 a10. g10 f4 d4 | e4 g4 b-4 g4 | f1 | r2 r4 c10. e10 |
#label OUTRO
@fade{0,64} r4 d10. f10 a4 g10. f10 | e2. r10. c10 | a4&a10. g10 a4 >c4< | a2 r4 f10. g10 |
b-4&b-10. a10 g4 f10. d10 | e4 g10. b-10 >d4 c4< | >c4< a4 f+4 a4 | g2 e4 r4 |
f4&f10. d10 f4 a4 | g2 f4 e-4 | e4&e10. c10 e4 g4 | f+2 a4 >c4< |
b-4 a10. g10 f4 d4 | e4 g4 b-4 g4 | f1 | r2 r4 c10. e10 |

#ch 矩形波 2
t108 @{nesPulse(25)} @e{pad} q8 v8 @fade{15,0}
#label LOOP
o4 f2. g4 | o4 e1 | o4 e2 c2 | o4 d2 e2 |
o4 f2. d4 | o4 e2 g2 | o4 g2 f+2 | o4 f2 e2 |
o4 d1 | o4 d-1 | o4 c1 | o4 c1 |
o3 b-1 | o3 b-1 | o3 a1 | o3 b-2 o4 e2 |
l8 @e{pluck} q6 o4 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o4 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o4 f10. a10 >c10. e10 f10. e10 c10.< a10 | o4 d10. f10 a10. >c10 d10. c10< a10. f10 |
o4 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o4 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o4 a10. >c10 e10. g10< o4 d10. f+10 a10. >c10< | o4 g10. b-10 >d10. f10< o4 c10. e10 g10. b-10 |
o3 b-10. >d10 f10. a10 b-10. a10 f10. d10< | o4 e-10. g10 b-10. >d-10 e-10. d-10< b-10. g10 | o4 a10. >c10 e10. g10 a10. g10 e10. c10< | o4 d10. f+10 a10. >c10 d10. c10< a10. f+10 |
o4 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o4 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o4 f10. a10 >c10. d10 f10. d10 c10.< a10 | o4 c10. e10 g10. b-10 >c10.< b-10 g10. e10 |
l8 @e{pluck} q6 o3 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o3 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o3 f10. a10 >c10. e10 f10. e10 c10.< a10 | o3 d10. f10 a10. >c10 d10. c10< v4 o6 f24 d24 c24 o5 a24 f24 d24 v8 |
o3 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o3 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o3 a10. >c10 e10. g10< o3 d10. f+10 a10. >c10< | o3 g10. b-10 >d10. f10< o3 c10. e10 v4 o6 e24 c24 o5 b-24 g24 e24 c24 v8 |
o2 b-10. >d10 f10. a10 b-10. a10 f10. d10< | o3 e-10. g10 b-10. >d-10 e-10. d-10< b-10. g10 | o3 a10. >c10 e10. g10 a10. g10 e10. c10< | o3 d10. f+10 a10. >c10 d10. c10< v4 o6 f+24 d24 c24 o5 a24 f+24 d24 v8 |
o3 g10. b-10 >d10. f10 g10. f10 d10.< b-10 | o3 c10. e10 g10. b-10 >c10.< b-10 g10. e10 | o3 f10. a10 >c10. d10 f10. d10 c10.< a10 | o3 c10. e10 g10. b-10 >c10.< b-10 v4 o6 e24 c24 o5 b-24 g24 e24 c24 v8 |
#label OUTRO
@fade{0,64} @e{pad} q8 o4 f2. g4 | o4 e1 | o4 e2 c2 | o4 d2 e2 |
o4 f2. d4 | o4 e2 g2 | o4 g2 f+2 | o4 f2 e2 |
o4 d1 | o4 d-1 | o4 c1 | o4 c1 |
o3 b-1 | o3 b-1 | o3 a1 | o3 b-2 o4 e2 |

#ch 三角波
t108 l4 @{nesTriangle} @e{flat} q7 v15
#label LOOP
o2 g a b- b | o3 c e g e | o3 f e d c | o3 d f a a- |
o3 g f d o2 b- | o3 c d e o2 b- | o2 a o3 e d o2 a | o2 g o3 d c o2 b |
o2 b- o3 d f d | o2 e- g b- a- | o2 a o3 c e c | o3 d o2 a f+ a |
o2 g b- o3 d o2 b- | o3 c o2 b- g e | o2 f a o3 c d | o3 c o2 b- a a- |
o2 g a b- b | o3 c e g e | o3 f e d c | o3 d f a a- |
o3 g f d o2 b- | o3 c d e o2 b- | o2 a o3 e d o2 a | o2 g o3 d c o2 b |
o2 b- o3 d f d | o2 e- g b- a- | o2 a o3 c e c | o3 d o2 a f+ a |
o2 g b- o3 d o2 b- | o3 c o2 b- g e | o2 f a o3 c d | o3 c o2 b- a a- |
o3 g4 b-4 o4 d4 o3 b-10. b10 | o4 c4 o3 g4 e4 g10. e10 | o3 f4 a4 o4 c4 o3 a10. c+10 | o3 d4 f4 a4 g10. a-10 |
o3 g4 f4 d4 o2 b-10. b10 | o3 c4 d4 e4 g10. b-10 | o3 a4 o4 c4 o3 d4 f+4 | o3 g4 b-4 c4 e10. a10 |
o3 b-4 o4 d4 f4 e10. e-10 | o4 e-4 o3 b-4 g4 g10. a-10 | o3 a4 o4 c4 e4 c10. c+10 | o4 d4 o3 a4 f+4 a10. a-10 |
o3 g4 b-4 o4 d4 o3 b-10. b10 | o4 c4 o3 b-4 g4 g10. e10 | o3 f4 a4 o4 c4 d4 | o3 c4 o2 b-4 a4 a-4 |
#label OUTRO
o2 g a b- b | o3 c e g e | o3 f e d c | o3 d f a a- |
o3 g f d o2 b- | o3 c d e o2 b- | o2 a o3 e d o2 a | o2 g o3 d c o2 b |
o2 b-2 o3 d2 | o2 e-2 b-2 | o2 a2 o3 e2 | o3 d2 o2 a2 |
o2 g1 | o3 c1 | o2 f1 | r1 |

#ch ノイズ
t108 @{nesNoise(long)} @e{snap} q8 v6 o5 @fade{0,0}
#label LOOP
r1 | r1 | r1 | r1 |
r1 | r1 | r1 | r1 |
@fade{10,96} r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c4 | r4 c4 r4 c10. v4 c10 v6 |
