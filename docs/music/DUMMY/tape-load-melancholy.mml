#title テープロードの憂鬱
#version 1.0
#about テープロード音と電子音で組み立てた楽曲。
#copyright 2026 harayoki
#license CC BY 4.0 (music and MML source; https://creativecommons.org/licenses/by/4.0/)

#bundle tapeLead  = @{beep:clean} @e{piano} @o+1 @s5
#bundle tapeSub   = @{beep:clean} @e{soft}
#bundle tapeArp   = @{pulse:25} @e{flat}
#bundle tapeBass  = @{triangle} @e{flat}
#bundle tapeKick  = @{fm2DrumKick} @e{percussive} @o-2
#bundle tapeSnare = @{fm2DrumSnare} @e{percussive}
#bundle tapeSnap  = @{fm2DrumSnare} @e{tap}
#bundle tapeHat   = @{fm2DrumCymbal} @e{tap} @o+2
#bundle tapeBeep  = @{beep:noisy} @e{percussive}

#ch テープ
t126 @e{flat} q8 @{tape:worn}{ @baud 1200 @seed 7 v9 =1 =1 ?4 r2 =1 r4 o2 a1 f1 c1 g1 a1 f1 c1 g1 v6 a1 f1 c1 g1 a1 f1 c1 g1 v5 @bytes ff a1 @bytes random @bytes 55 f1 @bytes random @bytes 0f c1 @bytes random @bytes 33 g1 @bytes random @bytes cc a1 @bytes random @bytes 99 f1 @bytes random @bytes 3c c1 @bytes random @bytes 81 g1 @bytes random c1 g1 a1 f1 c1 g1 a1 f1 v10 =1 r1 o3 c4 e4 g4 o4 c4 c2 r2 }

