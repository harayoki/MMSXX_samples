#ch ドラム
#drum B = @{tapeKick}      バスドラ
#drum S = @{tapeSnare} v10 スネア
#drum s = @{tapeSnap}  v10 スネア(短)
#drum H = @{tapeHat}   v3  ハイハット
$ta = { BH H H H BH H H H BH H H H BH H H H }
$tb = { BH H H H BSH H H H BH H H H BSH H H sH }
t126 q8 l16 r1 r1 r1 r1 r1 r1 r1 r1
@{drums 16}{ v6 [$ta |]4 }
@{drums 16}{ v9 [$tb |]8 }
@{drums 16}{
#drum S = @{tapeSnare} v13 スネア
#drum s = @{tapeSnap}  v13 スネア(短)
v13 [$tb |]16 }
r1 r1 r1 r1

#ch ビープ
