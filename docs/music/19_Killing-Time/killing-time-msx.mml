#title killing time (PSG+OPLL+SCC ver.)
#version 1.0.12
#snap front
#about ユーロビート風の習作をMSX音源で再現した物。
#voice sccNoiseA = @scc{ bytes{107, -75, -106, -53, -61, -57, -25, -36, -57, -24, 7, -97, -110, 78, -22, -37, -40, 11, 68, -82, 18, 75, -10, 8, -68, -80, -35, 56, 58, 25, 37, 26} }
