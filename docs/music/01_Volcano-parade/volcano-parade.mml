/*
JS側の音色・エンベロープ設定が必要です。
MMLだけをコピーしても元の音色・鳴り方は再現できません。
設定元: docs/music/01_Volcano-parade/player.js
独自音色: vpLead, vpPiano, vpTom, vpBass。
独自エンベロープ: vpLegacy0…（音長に応じて動的生成・適用）。
音色登録に加え、prepare() によるエンベロープ・音量・ゲート補正も必要。
以下はJS側の設定コードです。コメント内なのでMMLからは実行されません。
エンジン読込後、MMLを読み込む前に、利用先のJavaScriptへコピーしてください。
audio は再生に使用する ChipTuneSound インスタンスです。
設定コードと適用コードは同じスコープに置いてください。

--- 設定コード（JavaScript） ---
const E = MMSXX.sound;
const sampleCycle = fn => Array.from({ length: 32 }, (_, i) => fn(i / 32));
const triangleAt = x => 1 - 4 * Math.abs(x - .5);

function filteredSquare(cutoff, resonance, mix) {
  return sampleCycle(x => {
    let sum = 0;
    for (let harmonic = 1; harmonic <= 15; harmonic += 2) {
      const n = harmonic * cutoff / resonance;
      const gain = 1 / Math.hypot(1 - n * n, n / mix);
      const phase = -Math.atan2(n / mix, 1 - n * n);
      sum += 4 / Math.PI / harmonic *
        Math.sin(2 * Math.PI * harmonic * x + phase) * gain;
    }
    return sum;
  });
}

function bassCycle(cutoff, squareMix) {
  const square = filteredSquare(cutoff, Math.max(360, 900 - cutoff * 2.5), .45);
  return Array.from({ length: 32 }, (_, i) =>
    triangleAt(i / 32) + squareMix * square[i]);
}

function registerVoices(audio) {
  audio.volume = 10 ** (12.56 / 20);
  E.registerTone('vpLead', {
    wave: 'pulse:50',
    vib: { depth: 5, speed: 6, delay: 18 },
    overwrite: true,
    role: 'lead',
    note: 'Square lead; vibrato starts after 18 frames.',
    noteJa: '18フレーム後からビブラートが入る矩形波リード。',
  });
  audio.addFM('vpPiano', {
    ratio: 3, depth: 3, attack: .001, decay: .07, sustain: .1, wave: 'sine',
  }, {
    overwrite: true, role: 'chord',
    note: 'Bright, rounded short piano.',
    noteJa: '明るく丸い短いピアノ。',
  });
  audio.addFM('vpTom', {
    ratio: 1, depth: 3, attack: .002, decay: .1, sustain: .06,
    wave: 'sine', drop: .25, dropTime: .025,
  }, {
    overwrite: true, role: 'perc',
    note: 'Tom-like body with a shallow pitch drop.',
    noteJa: '浅く音程が落ちるタム風の音。',
  });
  audio.addWave('vpBass', bassCycle(120, .36), 8, {
    overwrite: true, role: 'bass',
    note: 'Triangle and filtered pulse bass.',
    noteJa: '三角波とフィルター矩形波を混ぜたベース。',
  });
  audio.addWave('vpBassLow', bassCycle(92, .45), 8, {
    overwrite: true, role: 'bass',
    note: 'Low triangle and filtered pulse bass.',
    noteJa: '低域用の三角波とフィルター矩形波のベース。',
  });
  audio.addWave('vpBassHi', bassCycle(180, .24), 8, {
    overwrite: true, role: 'bass',
    note: 'High triangle and filtered pulse bass.',
    noteJa: '高域用の三角波とフィルター矩形波のベース。',
  });
}

const CHANNELS = { ARP: 0, MELODY: 1, BASS: 2, CALL: 3, CALL_LOW: 4, HAT: 5 };
const VOICE_GAINS = {
  saw: { f: .065, cap: .24, comp: 1.078 },
  'pulse:50': { f: .055, cap: .24, comp: 1.079 },
  vpLead: { f: .055, cap: .24, comp: 1.079 },
  vpBass: { f: .115, cap: .24, comp: .917 },
  vpPiano: { f: .115, cap: .27, comp: .695 },
  vpTom: { f: .115, cap: .24, comp: 1.227 },
};
const DEFAULT_GAIN = { f: .055, cap: .24, comp: 1 };
const CHANNEL_GAINS = [.98, 1.049, 1.233, 1.063, 1.09, 1, 1, .98];
const legacyEnvelopes = [
  { a: .005, d: 0, s: 1, r: .01 },
  { a: .08, d: .1, s: .8, r: .15 },
  { a: .002, d: .25, s: 0, r: .05 },
  { a: .004, d: .4, s: .35, r: .12 },
  { a: .25, d: .2, s: .7, r: .4 },
  { a: .002, d: .12, s: .15, r: .08 },
];
const envelopeCache = new Map();

function legacyVolume(value) {
  return Math.max(0, Math.min(15, 15 * Math.pow(Math.max(0, 3 * value), 1 / 1.8)));
}

function adaptEnvelopes(tracks) {
  for (const track of tracks) for (const event of track.events) {
    const wave = E.WAVEFORMS[event.wave];
    if (wave.kind === 'pulse' && wave.duty === .5) event.vol *= Math.pow(.85, 1 / 1.8);
    const spec = legacyEnvelopes[event.env];
    if (!spec) continue;
    const duration = Math.max(.02, event.gate);
    const key = event.env + ':' + duration;
    if (!envelopeCache.has(key)) {
      const name = 'vpLegacy' + envelopeCache.size;
      E.registerEnvelope(name, {
        ...spec, d: spec.d * duration,
        note: 'Converted Volcano Parade envelope.',
        noteJa: 'Volcano Paradeの旧音長比例エンベロープを秒指定へ変換。',
      });
      envelopeCache.set(key, E.ENVELOPES.findIndex(env => env.name === name));
    }
    event.env = envelopeCache.get(key);
    event.open = false;
  }
}

function balanceTracks(tracks) {
  const events = ch => tracks[ch]?.events ?? [];
  for (const track of tracks) for (const event of track.events) event.__g = 1;
  const leads = [CHANNELS.MELODY, CHANNELS.CALL, CHANNELS.CALL_LOW].flatMap(events);
  for (const event of events(CHANNELS.ARP)) {
    event.__g = 1.08;
    const end = event.t + event.gate;
    if (leads.some(other => other.t < end && other.t + other.gate > event.t)) event.__g *= .48;
  }
  const beat = 60 / 135;
  for (const event of events(CHANNELS.BASS)) {
    const phase = event.t / beat % 1;
    event.__g *= Math.abs(phase - .5) < .09 ? 1.38 : .84;
  }
  events(CHANNELS.HAT).forEach((event, index) => { event.__open = index % 16 === 15; });
  const gateTail = [.0041, .0014, .0011, .0022, .0014, .0016];
  for (const [ch, track] of tracks.entries()) {
    if (ch !== CHANNELS.HAT) {
      for (const event of track.events) event.gate += gateTail[event.env] ?? .0014;
    }
  }
  for (const [ch, track] of tracks.entries()) for (const event of track.events) {
    const linear = event.vol / 15 * event.__g;
    let gain;
    if (ch === CHANNELS.HAT) {
      gain = Math.min(event.__open ? .026 : .035,
        linear * (event.__open ? .018 : .025)) * Math.pow(10, 9 / 20);
    } else {
      const spec = VOICE_GAINS[E.WAVEFORMS[event.wave].name] ?? DEFAULT_GAIN;
      gain = Math.min(spec.cap, linear * spec.f) * spec.comp;
    }
    event.vol = legacyVolume(gain) * (CHANNEL_GAINS[ch] ?? 1);
    delete event.__g;
  }
}

function prepare(audio) {
  const tracks = audio.bgmDefs.get('__player__');
  if (!Array.isArray(tracks)) return;
  balanceTracks(tracks);
  adaptEnvelopes(tracks);
}

registerVoices(audio);
audio.psgTune = false;
audio.dynamic_effects[CHANNELS.ARP] = { detune: 7 };

--- MML読込後・再適用後のコード（JavaScript） ---
// player.mount / player.setMML の直後に実行（BGM名は __player__）。
prepare(audio);
*/

// この数値を直すと本編のループ回数が変わります（1以上）。
// イントロとエンディングは1回ずつ。全パート共通で、再生とWAVの両方に適用。
$LOOP_END = { 2 }
// この曲用の音色 — プリセットに無い音色でやりたい事が特殊だったのでJavaScriptで計算で作っている(mmsxx-mml-studio の addWave / registerTone)。
//   @{vpLead}   メロディ部の矩形波。 0.30 秒遅れてビブラート(6Hz / 2%)が掛かる。
//   @{saw}      アルペジオとハモリのパート用ののこぎり波。
//   @{vpPiano}  合いの手。キンキンした硬いピアノ風(2 オペ FM)。
//   @{vpTom}    合いの手に重ねるタム。音階を聞かせる。
//   @{vpBass}   ベース。三角波に、ローパスを通した矩形波を混ぜている。
//   @{noise:white}    ハイハット。o4 の a で鳴らすと白色ノイズになる。
// 音量とグルーヴ(重なったときの引き / 8 分の裏の張り / 16 打ごとのオープン)調整は
// 現在のMMLでは書けないので、動的にJavaScript処理が音量を書き換えている。

#title Volcano Parade
#about 明るい循環進行と下降ベースを使った、タイトル／エンディング向けの曲。
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)

#bundle vpArpVoice   = @{saw} @e{flat}
#bundle vpLeadVoice  = @{vpLead} @e{soft}
#bundle vpPulseSoft  = @{pulse:50} @e{soft}
#bundle vpBassVoice  = @{vpBass} @e{flat}
#bundle vpPianoVoice = @{vpPiano} @e{percussive}
#bundle vpSawSoft    = @{saw} @e{soft}
#bundle vpHatVoice   = @{noise:white} @e{percussive}
#bundle vpTomVoice   = @{vpTom} @e{percussive}
// Powered by mmsxx-mml-studio (engine license undecided; redistribution currently prohibited).
// K005289 arpeggio — MIDI ch.1 rhythm/contour, reharmonized
// アルペジオの7セント重ねはplayer.jsのdynamic_effectsで指定。
// ベースが半音〜全音ずつ下降するよう、各拍を転回形中心に再配置。
// D-A/C#-Bm-D/A → A-E/G#-F#m-A/E → Bm-F#m/A-G-D/F# → G-D/F#-Em-A/C#。
// dim・9th・強いジャズテンションは使わず、明るい循環感を優先する。

$INTRO = { o6 d8. f+16 a8 >d8 <a4 f+8 e8 }
$D_to_A = { o6 d f+ a >d  <c+ e a >c+  <b d f+ >b  <a d f+ a }
$A_to_Bm = { o5 a c+ e >a  <g+ b e g+  f+ a c+ f+  e a c+ e }
$Bm_to_G = { o5 b d f+ >b  <a c+ f+ a  g b >d g  <f+ a >d f+ }
$G_to_D = { o5 g b >d g  <f+ a >d f+  <e g b >e  <c+ e a >c+ }
$D_RETURN = { o5 d f+ a >d  <c+ e a >c+  <b d f+ >b  <a d f+ a }
// 2周目は同じ下降線の上で、Bm/F#mをG/Dへ置換して少し開けた響きにする。
$D2_to_A = { o6 d f+ a >d  <c+ e a >c+  <b d g >b  <a d f+ a }
$A2_to_Bm = { o5 a c+ e >a  <g+ b e g+  f+ a d f+  e a c+ e }
$Bm2_to_A = { o5 b d f+ >b  <a c+ f+ a  g+ b e g+  f+ a >d f+ }
$A2_to_D = { o5 a c+ e >a  <g+ b e g+  f+ a d f+  e a c+ e }
// Bメロ: Fメジャーへ転調。8小節目のA7→DでAメロのDメジャーへ戻す。
// F-C/E-Dm-Bb | Gm-C-A7-D。アルペジオは16分音符を切らさない。
$B1 = { o5 f a c >f  <c a f c  f a c >f  <c a f c }
$B2 = { o5 e g c >e  <c g e c  e g c >e  <c g e c }
$B3 = { o5 d f a >d  <a f d a  d f a >d  <a f d a }
$B4 = { o5 b- d f >b-  <f d b- f  b- d f >b-  <f d b- f }
$B5 = { o5 g b- d >g  <d b- g d  g b- d >g  <d b- g d }
$B6 = { o5 c e g >c  <g e c g  c e g >c  <g e c g }
$B7 = { o5 a c+ e g  a g e c+  a c+ e g  a g e c+ }
$B8 = { o5 d f+ a >d  <a f+ d a  d f+ a >d  <a f+ d a }
// Cメロ: G-A-F#m-Bm | Em-G/A-A7-A7。上昇感を作り、AメロのDへ接続する。
$C1 = { o5 g b >d g  <d b g d  g b >d g  <d b g d }
$C2 = { o5 a c+ e >a  <e c+ a e  a c+ e >a  <e c+ a e }
$C3 = { o5 f+ a c+ >f+  <c+ a f+ c+  f+ a c+ >f+  <c+ a f+ c+ }
$C4 = { o5 b d f+ >b  <f+ d b f+  b d f+ >b  <f+ d b f+ }
$C5 = { o5 e g b >e  <b g e b  e g b >e  <b g e b }
$C6 = { o5 a b d g  a g d b  a b d g  a g d b }
$C7 = { o5 a c+ e g  a g e c+  a c+ e g  a g e c+ }
$C8 = { o5 a c+ e g  c+ e g >c+  <a g e c+  a e c+ a }
// 静かな4小節＋イントロ2。前半は高域を止め、最後の1小節だけ共通フレーズを戻す。
$QUIET = { r1 r1 o5 d2 a2  r2 e4 a4 }
$INTRO2 = { r1 o5 a8. f+16 d8 e8 f+4 e8 c+8 }
#ch アルペジオ
#role arp
t135 l16 q7 v8 @{vpArpVoice} @d0
// 小節別主役: M M A F | M B M F | M B A M（M=メロディ、A=アルペジオ、B=ベース、F=合いの手）
#label イントロ
[ v6 $INTRO
#label Aメロ
[ v8 $D_to_A v8 $A_to_Bm v11 $Bm_to_G v6 $G_to_D v8 $D2_to_A v7 $A2_to_Bm v8 $Bm2_to_A v6 $A2_to_D
#label Bメロ
v8 $B1 v7 $B2 v9 $B3 v7 $B4 v8 $B5 v7 $B6 v9 $B7 v8 $B8
#label Cメロ
v8 $C1 v9 $C2 v7 $C3 v9 $C4 v8 $C5 v10 $C6 v9 $C7 v8 $C8
#label 静かな区間
v4 $QUIET
#label イントロ2
v6 $INTRO2 ]$LOOP_END
// Ending: 後半で和音全体を半音ずつ駆け上がり、1オクターブ上へ到達する。
#label エンディング
o5 v7 @{vpArpVoice} d2 d8 d+32 e32 f32 f+32 g32 g+32 a32 b-32 b32 >c32 c+32 d32

#ch メロディ
#role lead
// AY melody — 忙しいアルペジオとベースに対し、長音と休符で呼吸を作る。
// この旋律ではポルタメントを使わず、音階の順次進行で滑らかに聞かせる。
// 4・8小節目は全休符にして合いの手へ渡す。
// イントロだけは全パートが同じフレーズをユニゾンで演奏する。
// デチューン高音に埋もれないようv12。@e{soft}で80%まで穏やかに減衰する。
// 2分音符だけ@{vpLead}へ切替。約0.3秒はビブラートなしの直進音、その後ビブラートが立ち上がる。
t135 l16 q8 v12 @{vpPulseSoft}
// 1小節イントロ共通フレーズ。
[ o5 v9 d8. f+16 a8 >d8 <a4 f+8 e8 [ o5 v13 @{vpLeadVoice} f+2 @{pulse:50} e4 d4 o5 v13 @{vpLeadVoice} c+2
  @{pulse:50} b4 r4 o5 v10 @{vpLeadVoice} d2 @{pulse:50} e4 f+4 o5 r1 o5 v13 @{vpLeadVoice} a2 @{pulse:50} g4
  f+4 o5 v10 @{vpLeadVoice} e2 @{pulse:50} d4 r4 o5 v13 @{vpLeadVoice} f+2 @{pulse:50} e4 d4 o5 r1
// Bメロ8小節。Fメジャーの明るさを保ち、後半で進行感を強めてDへ帰る。
o5 v13 @{vpLeadVoice} a2 @{pulse:50} g4 f4 o5 v10 @{vpLeadVoice} g2 @{pulse:50} e4 r4 o5 v11 @{vpLeadVoice} f2
  @{pulse:50} a4 g4 o5 v12 @{vpLeadVoice} d2 @{pulse:50} f4 r4 o5 v11 @{vpLeadVoice} b-2 @{pulse:50} a4 g4 o5
  v12 @{vpLeadVoice} g2 @{pulse:50} c4 b-4 o5 v13 @{vpLeadVoice} c+2 @{pulse:50} e4 g4 o5 v13 @{vpLeadVoice} f+2
  @{pulse:50} e4 d4
// Cメロ8小節。Bより高い音域へ持ち上げ、後半はA7上でAメロを待つ。
o5 v12 @{vpLeadVoice} b2 @{pulse:50} a4 g4 o5 v13 @{vpLeadVoice} c+2 @{pulse:50} e4 a4 o5 v11 @{vpLeadVoice} a2
  @{pulse:50} c+4 b4 o5 v13 @{vpLeadVoice} d2 @{pulse:50} f+4 a4 o5 v12 @{vpLeadVoice} g2 @{pulse:50} b4 >e4 o6
  v13 @{vpLeadVoice} d2 @{pulse:50} c+4 b4 o5 v12 @{vpLeadVoice} a2 @{pulse:50} c+4 e4 o5 v13 @{vpLeadVoice} g2
  @{pulse:50} e4 c+4
// 静かな4小節。長音と休符で密度を落とす。
o5 v7 @{vpPulseSoft} d1 o5 r1 o4 v7 @{vpLeadVoice} a2 @{pulse:50} g4 r4 o4 v6 @{vpLeadVoice} e2 r2
// イントロ2。
o5 r1 o5 v11 @{vpPulseSoft} a8. f+16 d8 e8 f+4 e8 c+8 ]$LOOP_END
// Ending: root rises chromatically by one octave.
o5 v9 @{vpLeadVoice} d2 d8 d+32 e32 f32 f+32 g32 g+32 a32 b-32 b32 >c32 c+32 d32

#ch ベース
#role bass
// Triangle bass — low eighth + two high sixteenths。跳躍を抑えた下降ベース。
// 全区間・全音で、輪郭を補うpulse:50矩形波を元の約半分の強さで同音程に重ねる。
// 半音または全音で下がり、4拍目で少し止めてから次の小節へ着地する。
t135 l16 q7 v14 @{vpBassVoice}
// イントロはメロディーと同じフレーズを低音ユニゾンで演奏する。
[ v10 o2 d8. f+16 a8 >d8 <a4 f+8 e8 [ v11 o2 d8 >d d o2 c+8 >c+ c+ o2 b8 >b b o2 a8 >a a v11 o2 a8 >a a o2 g+8
  >g+ g+ o2 f+8 >f+ f+ o2 e8 >e e v11 o2 b8 >b b o2 a8 >a a o2 g+8 >g+ g+ o2 f+8 >f+ f+ v9 o2 g8 >g g o2 f+8 >f+
  f+ o2 e8 >e e o2 c+8 >c+ c+ v11 o2 d8 >d d o2 c+8 >c+ c+ o2 b8 >b b o2 a8 >a a v14 o2 a8 >a a o2 g+8 >g+ g+ o2
  f+8 >f+ f+ o2 e8 >e e v11 o2 b8 >b b o2 a8 >a a o2 g8 >g g o2 f+8 >f+ f+ v9 o2 a8 >a a o2 g+8 >g+ g+ o2 f+8
  >f+ f+ o2 e8 >e e
// Bメロは4分音符中心。後半で根音の動きを強め、A7からDへ帰る。
v10 o2 f4 c4 f4 e4 v12 o2 e4 g4 c4 e4 v10 o2 d4 a4 d4 c4 v11 o2 b-4 f4 b-4 a4 v12 o2 g4 d4 g4 b-4 v11 o2 c4 g4
  c4 b-4 v13 o2 a4 e4 g4 c+4 v13 o2 d4 a4 d4 r4
// Cメロは上向きの4分音符パターン。終盤はAを保持して帰着を待つ。
v11 o2 g4 d4 g4 b4 v12 o2 a4 e4 a4 c+4 v10 o2 f+4 c+4 f+4 a4 v12 o2 b4 f+4 b4 d4 v11 o2 e4 b4 e4 g4 v13 o2 a4 e4
  g4 b4 v12 o2 a4 e4 g4 c+4 v13 o2 a4 a4 e4 c+4
// 静かな4小節。根音を長く保持する。
v7 o2 d1 v6 o2 b-1 v7 o2 g1 v8 o2 a1
// イントロ2。
o2 r1 v10 o2 a8. f+16 d8 e8 f+4 e8 c+8 ]$LOOP_END
// Ending: low D rises chromatically by one octave.
o2 v11 @{vpBassVoice} d2 d8 d+32 e32 f32 f+32 g32 g+32 a32 b-32 b32 >c32 c+32 d32

#ch 合いの手／ハモリ
#role harmony
// AY call-and-response / harmony — Aメロは4・8小節目の合いの手、Bメロは主旋律の下ハモリ。
// 合いの手は vpPiano + percussive。鳴り始めを強くし、短く切れる金属音にする。
// ハモリは saw + softで主旋律より少し細くする。
t135 o4 l8 q5 v10 @{vpPianoVoice}
// I1の後、A・B・C・静かな4小節・I2を2回。
r1 [ o4 r1 r1 r1 v15 r8 g8 b8 >d8 <a8 f+8 e8 c+8 r1 r1 r1 v15 r8 a8 >c+8 e8 <b8 a8 f+8 e8
// Bメロ: Fメジャー内で主旋律からおおむね3度下。リズムと休符位置は主旋律に揃える。
o5 l16 q8 v8 @{vpSawSoft} f2 e4 d4 o5 v7 e2 c4 r4 o5 v7 d2 f4 e4 o4 v8 b-2 >d4 r4 o5 v7 g2 f4 e4 o5 v8 e2 a4 g4
  o5 v8 a2 c+4 e4 o5 v8 d2 c+4 a4
// Cメロは3度下中心。終盤だけ反行してAへの戻りを目立たせる。
o5 v8 g2 f+4 e4 o5 v8 a2 c+4 e4 o5 v7 f+2 a4 g4 o5 v8 b2 d4 f+4 o5 v8 e2 g4 b4 o5 v9 b2 a4 g4 o5 v8 f+2 a4 c+4
  o5 v8 e2 c+4 a4
// 静かな4小節ではハモリを止める。
o4 r1 r1 r1 r1
// I2の最後だけ低い合いの手を入れる。
o4 r1 o4 v11 @{vpPianoVoice} a8. f+16 d8 e8 f+4 e8 c+8 ]$LOOP_END
// Ending: major third rises chromatically by one octave.
o5 l16 q8 v7 @{vpPulseSoft} f+2 f+8 g32 g+32 a32 b-32 b32 >c32 c+32 d32 d+32 e32 f32 f+32

#ch 合いの手低音
#role harmony
// 合いの手のオクターブ下レイヤー。単旋律MMLでは同時発音できないため独立チャンネルで重ねる。
$REST4 = { r1 r1 r1 r1 }
$REST8 = { r1 r1 r1 r1 r1 r1 r1 r1 }
t135 o3 l8 q5 v8 @{vpPianoVoice}
// I1
r1
// Aの4・8小節目だけ上の合いの手と同時発音。B・C・静かな区間は休む。
[ o3 r1 r1 r1 v9 r8 g8 b8 >d8 <a8 f+8 e8 c+8 r1 r1 r1 v9 r8 a8 >c+8 e8 <b8 a8 f+8 e8 $REST8 $REST8 $REST4
// I2
r1 o3 v8 a8. f+16 d8 e8 f+4 e8 c+8 ]$LOOP_END
// Ending: fifth rises chromatically by one octave.
o4 l16 q8 v6 @{vpPulseSoft} a2 a8 b-32 b32 >c32 c+32 d32 d+32 e32 f32 f+32 g32 g+32 a32

