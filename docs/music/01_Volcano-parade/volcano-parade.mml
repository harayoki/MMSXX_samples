#wave vpBass = @bits{8} @role{bass} -1.356 -1.064 -0.713 -0.450 -0.239 -0.071 0.082 0.218 0.352 0.479 0.608 0.733 0.860 0.983 1.111 1.233 1.356 1.064 0.713 0.450 0.239 0.071 -0.082 -0.218 -0.352 -0.479 -0.608 -0.733 -0.860 -0.983 -1.111 -1.233

#voice vpSoft = @adsr{0.08, 10%, 0.8, 0.15}
#voice vpPercussive = @adsr{0.002, 25%, 0, 0.05}


#voice vpFlat = @adsr{0.005, 0, 1, 0.01}
#voice vpArp = @{saw} @role{arp} @gain{1}, @{saw} @gain{0.6} @d7

// vpBassは計算済み32サンプルを上の #wave で定義。生成元: scripts/volcano_bass_wave.cjs。
// 音色定義はMMLとエンジン内蔵音色のみ。曲固有のJS音色登録は不要。
// 主旋律は pulse(50) と @m{5,6,18}。他の音色へ切り替える際に @m0。
//   @{saw}      アルペジオとハモリのパート用ののこぎり波。
//   @{opllHarpsichord} 合いの手。比較で3番目だった内蔵OPLLチェンバロ。硬いアタック。
//   @{opllpTomTom} 合いの手に重ねる内蔵OPLLPタム。音階を聞かせる。
//   @{vpBass}   ベース。三角波に、ローパスを通した矩形波を混ぜている。
//   @{noise(white)}    ハイハット。o4 の a で鳴らすと白色ノイズになる。
// 音量・裏拍アクセント・主旋律と重なるアルペジオの抑制は、各音のvへ移行済み。
// JSマスター増幅を解除。旧ミックスをvへ換算し、15を超える音は15に制限。
// 同じ小節はマクロを共有。演奏順は各チャンネル末尾に記載。

#title Volcano Parade
#version 5.16
#about 明るい循環進行と下降ベースを使った、タイトル／エンディング向けの曲。
#copyright 2026 harayoki
#license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)

#bundle vpLeadVoice  = @{pulse(50)} @e{vpSoft}
#bundle vpPulseSoft  = @{pulse(50)} @e{vpSoft}
#bundle vpBassVoice  = @{vpBass} @e{vpFlat}
// チェンバロは元の1オクターブ上を基準に、5度上・さらに1オクターブ上を重ねる。
#bundle vpPianoVoice = @{opllHarpsichord} @e{vpPercussive} @o+1, @{opllHarpsichord} @e{vpPercussive} @o+1 @d700, @{opllHarpsichord} @e{vpPercussive} @o+2
#bundle vpSawSoft    = @{saw} @e{vpSoft}
#bundle vpHatVoice   = @{noise(white)} @e{vpPercussive}
#bundle vpTomVoice   = @{opllpTomTom} @e{vpPercussive}
// Powered by mmsxx-mml-studio (engine license undecided; redistribution currently prohibited).
// K005289 arpeggio — MIDI ch.1 rhythm/contour, reharmonized
// アルペジオは合成音色で7セント上・音量60%の層を重ねる。
// ベースが半音〜全音ずつ下降するよう、各拍を転回形中心に再配置。
// D-A/C#-Bm-D/A → A-E/G#-F#m-A/E → Bm-F#m/A-G-D/F# → G-D/F#-Em-A/C#。
// dim・9th・強いジャズテンションは使わず、明るい循環感を優先する。


