#voice dSnareW0 = @scc{ bytes{-54, -27, -78, -84, -89, -108, -111, -55, -23, 27, 36, 61, 68, 119, 126, 115, 127, 101, 108, 63, 44, -16, -22, -64, -86, -39, -35, -27, -29, -24, 19, -40} }
