#title 沙羅曼蛇 ボスBGM near Arcade(?) MSX OPLL + SCC + PSG Ver.
#about 沙羅曼蛇のボス曲（Poison of Snake） をMSX音源で。令和の技術でアーケード版のBGMに近づけてみました。
#version 1.0.1
#gain 1


// 音色は samples/addons/gamenotes の 3 つのドラムキットと gamenotes::sccSrmnd を引く。
// 鳴らす側でアドオンを読み込んでおくこと。
// 実機の声の数に収まっているかは node scripts/check-msx-voices.mjs で見る。
// opm-split.mml と同じ音符。音色だけ MSX の音源へ移した

// SCC の音色。OPM の録りから、倍音を測って 32 点の波形に起こしたもの

#voice leadEnv = @adsr{0.002, 0, 1, 0.45}
#voice leadEnvB = @adsr{0.002, 0, 1, 0.15}
#voice leadCut = @adsr{0.002, 0, 1, 0.32}
#voice subEnv = @adsr{0.002, 0, 1, 0.1}
#voice bassEnv = @adsr{0.002, 0, 1, 0.8}

// 打楽器の SCC 音色。OPM の録りから倍音を測って起こした(→ sccdrum.mjs)
#voice dKickW0 = @scc{ bytes{-15, 30, 110, 14, -54, -40, -72, -78, -65, -62, -87, -82, -72, -78, 26, 88, 20, 62, 92, 84, 70, -62, -84, 11, -6, 4, 65, 104, 69, 14, 2, -9} }
#voice dKickW1 = @scc{ bytes{39, 9, -32, -103, -97, -77, -53, 41, 84, 102, 101, 26, -13, -57, -90, -87, -42, 19, 32, 93, 110, 104, 75, 59, 16, -32, -58, -81, -73, -55, 0, 39} }
#voice dKickW2 = @scc{ bytes{2, 26, 63, 61, 93, 104, 102, 78, 71, 70, 74, 51, -36, -97, -110, -78, -63, -68, -89, -107, -110, -94, -73, -40, -18, 35, 55, 35, 6, 14, 34, 12} }
#voice dKickW3 = @scc{ bytes{60, 36, -60, -96, -96, -104, -41, 6, 69, 110, 97, 97, 32, -28, -45, -88, -88, -34, 22, 43, 101, 108, 95, 44, -24, -71, -89, -103, -80, 0, 50, 77} }
#voice dKickW4 = @scc{ bytes{-54, -3, 60, 66, 94, 65, 34, 37, -19, -56, -90, -105, -90, -98, -91, -3, -4, 7, 56, 70, 66, 58, 80, 70, 64, 97, 23, 4, -20, -100, -107, -110} }
#voice dKickW5 = @scc{ bytes{-103, -80, -29, -7, 23, 53, 98, 106, 56, 44, 58, 68, 51, 37, 22, 9, 20, 65, 84, 82, 56, 23, -19, -39, -55, -71, -90, -92, -91, -87, -83, -110} }
#voice dKickW6 = @scc{ bytes{-84, -72, -86, -100, -97, -110, -87, -71, -30, 53, 42, 67, 72, 77, 71, 62, 28, 1, 3, -21, 0, 36, 85, 102, 90, 110, 110, 37, -17, -69, -100, -101} }
#voice dKickW7 = @scc{ bytes{89, 102, 92, 56, 25, 11, -1, -34, -8, -7, 23, 83, 96, 89, 36, 38, 53, 28, -6, -28, -63, -85, -99, -108, -110, -84, -70, -94, -58, -8, 1, 41} }
#voice dKick = @{dKickW0} @sccseq{dKickW0 1, dKickW1 1, dKickW2 1, dKickW3 1, dKickW4 1, dKickW5 1, dKickW6 1, dKickW7 1} @vol{11, 9, 7, 5, 3, 3, 2, 1, 0}

#voice dSnareW0 = @scc{ bytes{-47, -23, -68, -73, -77, -94, -97, -48, -20, 23, 31, 53, 59, 104, 110, 100, 110, 88, 94, 55, 38, -14, -19, -56, -75, -34, -30, -23, -25, -21, 17, -35} }
#voice dSnareW1 = @scc{ bytes{23, -40, -34, -28, -56, -80, -63, -79, -79, -71, -70, -71, -98, -82, -74, -40, -54, -34, 5, 54, 91, 100, 104, 107, 110, 102, 88, 94, 76, 69, 29, 1} }
#voice dSnareW2 = @scc{ bytes{-1, -1, 25, 53, 64, 69, 90, 89, 71, 93, 105, 102, 104, 84, 53, 50, 40, 14, -31, -42, -64, -90, -108, -109, -108, -94, -110, -84, -79, -84, -50, -50} }
#voice dSnareW3 = @scc{ bytes{84, 103, 101, 98, 110, 110, 103, 84, 50, 27, 13, -18, -23, -50, -80, -85, -77, -94, -98, -110, -103, -94, -73, -64, -75, -23, -23, -4, 17, 45, 72, 76} }
#voice dSnareW4 = @scc{ bytes{-90, -80, -85, -109, -110, -96, -99, -88, -86, -57, -19, -23, -6, 24, 38, 64, 82, 106, 97, 109, 110, 97, 107, 106, 79, 58, 39, 13, -1, -38, -55, -86} }
#voice dSnareW5 = @scc{ bytes{29, 47, 68, 76, 92, 90, 107, 102, 106, 110, 106, 82, 63, 36, 5, -28, -38, -43, -85, -93, -105, -106, -100, -101, -104, -89, -74, -69, -50, -30, -18, 15} }
#voice dSnareW6 = @scc{ bytes{100, 96, 84, 65, 63, 36, -8, -30, -36, -58, -87, -76, -85, -90, -104, -108, -108, -90, -76, -70, -45, -43, -15, 20, 33, 51, 70, 83, 104, 106, 110, 109} }
#voice dSnareW7 = @scc{ bytes{-37, -64, -82, -104, -105, -104, -106, -93, -110, -110, -80, -68, -35, -8, 13, 44, 60, 74, 82, 95, 90, 107, 109, 91, 79, 90, 86, 52, 32, 16, 4, -19} }
#voice dSnare = @{dSnareW0} @sccseq{dSnareW0 1, dSnareW1 1, dSnareW2 1, dSnareW3 1, dSnareW4 1, dSnareW5 1, dSnareW6 1, dSnareW7 1} @vol{7, 9, 8, 7, 6, 5, 4, 3, 0}

// タムタムのアドオン版。大きさだけバスドラムに合わせて下げたもの。
// いまは gamenotes::sccSrmnd::scctam のほうを使っている(TOM_FIT=0 で戻る)
#voice dTomAddon = @{gamenotes::grdsSccDrumkit::tom} @vol{12, 10, 9, 9, 8, 7, 0}

// 主旋律に重ねる倍音の FM。別チャンネルに出して #group で切れるようにした
#voice fmSine  = @opll{ mod{mul 1, tl 63, ar 15, dr 0, sl 0, rr 7, hold 1, wave 0, ksl 0, ksr 0}, car{mul 1, ar 15, dr 2, sl 2, rr 7, hold 1, wave 0, ksl 0, ksr 0}, feedback 0 }

// 主旋律。11 セント離した 2 声を 1 つの音色にまとめたもの
#voice sLeadA = @{gamenotes::sccSrmnd::sccleadA1}, @{gamenotes::sccSrmnd::sccleadA2} @d+11
#voice sLeadB = @{gamenotes::sccSrmnd::sccleadB1}, @{gamenotes::sccSrmnd::sccleadB2} @d+11
#voice fmV02d = @{opll::harpsichord}, @{opll::harpsichord}, @{opll::harpsichord}

// 打楽器は gamenotes::grdsSccDrumkit を引く。鳴らす側で grdsSccDrumkit.mjs を読み込んでおく

#ch SCC1 主旋律 1
#meta out scc1
