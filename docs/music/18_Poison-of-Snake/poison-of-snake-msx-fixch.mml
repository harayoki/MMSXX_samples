#voice dKickW5 = @scc{ bytes{-118, -92, -33, -8, 26, 61, 113, 122, 64, 51, 67, 78, 59, 42, 25, 10, 23, 75, 97, 94, 64, 27, -22, -45, -63, -82, -103, -106, -105, -100, -95, -127} }
