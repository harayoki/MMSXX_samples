// 主旋律に重ねる倍音の FM。別チャンネルに出して #group で切れるようにした
#voice fmSine  = @opll{ mod{mul 1, tl 63, ar 15, dr 0, sl 0, rr 7, hold 1, wave 0, ksl 0, ksr 0}, car{mul 1, ar 15, dr 2, sl 2, rr 7, hold 1, wave 0, ksl 0, ksr 0}, feedback 0 }

// 主旋律。11 セント離した 2 声を 1 つの音色にまとめたもの
#voice sLeadA = @{gamenotes::sccSrmnd::sccleadA1}, @{gamenotes::sccSrmnd::sccleadA2} @d+11
#voice sLeadB = @{gamenotes::sccSrmnd::sccleadB1}, @{gamenotes::sccSrmnd::sccleadB2} @d+11

// 打楽器は gamenotes::grdsSccDrumkit を引く。鳴らす側で grdsSccDrumkit.mjs を読み込んでおく

// タムタムへ食い込む尾を、隙間のぶんだけ残して切る音色
#voice bassUpCut1 = @adsr{0.002, 0, 1, 0.020}
#voice bassUpCut2 = @adsr{0.002, 0, 1, 0.030}
#voice bassUpCut3 = @adsr{0.002, 0, 1, 0.050}
#voice bassUpCut4 = @adsr{0.002, 0, 1, 0.200}
#voice bassUpCut5 = @adsr{0.002, 0, 1, 0.340}
#voice bassUpCut6 = @adsr{0.002, 0, 1, 0.490}
#voice bassUpCut7 = @adsr{0.002, 0, 1, 0.640}
#voice bassUpCut8 = @adsr{0.002, 0, 1, 0.770}
#voice bassUpCut9 = @adsr{0.002, 0, 1, 0.780}

#ch A 主旋律 1(SCC)
#meta out scc1
t170.5 q8 v5 @p{0} @{gamenotes::sccSrmnd::sccleadA1} @e{leadEnv}
