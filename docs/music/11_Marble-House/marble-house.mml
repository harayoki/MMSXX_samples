#voice breakShakeEnv = @adsr{0.008,0.035,0,0.012}
#bundle breakShake = @{ayNoise} @e{breakShakeEnv}
#drum I = @{ms89newmarbleKickLoud} v15 !kick イントロキック
#drum J = @{opll::snare} v15 !snare イントロスネア
