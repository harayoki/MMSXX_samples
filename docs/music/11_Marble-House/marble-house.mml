#wave sccms89newsccMarbleEP = @bits{8} @role{chord} 0/127 43/127 72/127 104/127 123/127 124/127 127/127 119/127 100/127 92/127 76/127 58/127 52/127 37/127 21/127 16/127 0/127 -16/127 -21/127 -37/127 -52/127 -58/127 -76/127 -92/127 -100/127 -119/127 -127/127 -124/127 -123/127 -104/127 -72/127 -43/127
#title MARBLE HOUSE（OPLL&SCC）
#version 75.0
#about Rhodes寄りFMエレピへ修正。ブレイクはFM4音・SCC打楽器2音・PSGノイズ1音。
#tempo 128
#meter 4/4
#copyright 2026 harayoki
#license CC BY 4.0
#gain 2.886575 measured
#looptimes 1
#voice ms89newmarbleHat = @adsr{0.001,0.040,0,0.010}
#voice ms89newmarbleOpenHat = @adsr{0.001,0.18,0,0.025}
#voice ms89newbassBite = @adsr{0.001,0.028,0.45,0.002}
#voice sccms89newsccBassBodyEnv = @adsr{0.002,0.130,0.30,0.025}
#bundle ms89newdanceBass = @{sccTriangle} @e{sccms89newsccBassBodyEnv}
#voice ms89newchordShort = @adsr{0.003,0.260,0.35,0.055}
#voice ms89chordPSG = @{ayTone} @e{ms89newchordShort}
#voice ms89newchordD = @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d0, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d500, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d900
#voice ms89newchordB = @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d200, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d500, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d900
#voice ms89newchordF = @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d0, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d300, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d800
#voice ms89newchordX = @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d0, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d500, @{sccms89newsccMarbleEP} @e{ms89newchordShort} @d800
#bundle ms89newdanceArp = @{sccSine} @e{tap}
#bundle ms89newdanceHat = @{noise(hiss)} @e{snap} q0
#bundle ms89newdanceOpenHat = @{ayNoise} @e{ms89newmarbleOpenHat} q0 @o5
#voice ms89newmarbleKickLoud = @{opll::kick(low)}, @{opll::kick(low)} @gain{0.4}
#drum B = @{ms89newmarbleKickLoud} v15 !kick キック
#drum S = @{opll::snare} v11 !snare スネア
#drum H = @{ms89newdanceHat} v5 クローズハット
#drum O = @{noise(hiss)} v6 オープンハット
#drum C = @{opll::cymbal} v6 シンバル

#voice ms89dropEnv = @adsr{0.001,0.045,0,0.003}
#voice ms89kickDrop = @{ayTone} @e{ms89dropEnv} @pitch{0,-600,-1200,-1800}
#voice ms89snareDrop = @{ayTone} @e{ms89dropEnv} @pitch{600,0,-600,-1200}





#wave breakSccEP = @bits{8} @role{chord} 0/127 31/127 60/127 82/127 97/127 105/127 108/127 106/127 101/127 96/127 89/127 81/127 71/127 58/127 41/127 21/127 0/127 -21/127 -41/127 -58/127 -71/127 -81/127 -89/127 -96/127 -101/127 -106/127 -108/127 -105/127 -97/127 -82/127 -60/127 -31/127
