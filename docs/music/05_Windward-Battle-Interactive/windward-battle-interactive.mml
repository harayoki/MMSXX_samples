// #title 風渡りの境界 戦闘曲(インタラクティブ)
// #about 風渡りの境界 の戦闘曲を動的に切り変え可能にしたものです。ゲームの展開に合わせて使います。
// #arrangement Interactive Battle — 風渡りの境界
// #tempo 152
// #switch 1
// #copyright 2026 harayoki
// #license CC BY 4.0 (music, artwork and MML source; https://creativecommons.org/licenses/by/4.0/)
// エンカウント → 戦闘曲3種をテイク選択 → 勝敗をテイク選択。
// 切り替えの基本単位は l1。3つの戦闘曲は16小節にそろえてある。
// 3声。戦闘はベース専用、打楽器の隙間を副旋律が使う。
// @{wcFieldLead} 草原・イントロ・敗北の三角波メロディー。
// @{wcBattleLead} 戦闘・勝利の矩形波メロディーと副旋律。
// @{wcBass} 草原などの短く減衰する三角波ベース。
// @{wcBattleBass} 戦闘用の矩形波ベース。大ピンチは8分3連符（l12相当）。
// @{wcArp} 草原などの隙間に入る矩形波アルペジオ。
// @{wcKick} ピッチが急降下する標準FMのキック。
// @{noise:white} 打楽器。@e{wcDrumEnv}で短く減衰する。
// 音色はplayer.jsの標準APIで登録。@m1は標準ビブラート。

// 各曲の先頭で状態を初期化。その後、曲固有の設定を指定します。
$RESET = { o4 l4 t120 v10 q7 p3 @{pulse:50} @e{flat} @d0 @m0 @s0 @o0 }

// #ch 主旋律
// #role lead
// 音色・テンポ・音量の共通設定。音符は下のフレーズ／各曲に記述。
$sound1 = { @e{flat} @m0 t112 @{wcFieldLead} @s2 @m1 v10 q6 o5 }
$sound2 = { @e{flat} @m0 t152 @{wcBattleLead} @m1 v7 q6 o4 }
$sound3 = { @e{flat} @m0 t152 @{wcBattleLead} @m1 v7 q6 o5 }
$sound4 = { @e{flat} @m0 t152 @{wcBattleLead} @m1 v9 q6 o5 }
$sound5 = { @e{flat} @m0 t152 @{wcBattleLead} @m1 v8 q7 o5 }
$sound6 = { @e{flat} @m0 t132 @{wcBattleLead} @m1 v9 q6 o5 }
$sound7 = { @e{flat} @m0 t96 @{wcFieldLead} @m1 v9 q6 o5 }
$sound8 = { @e{flat} @m0 t96 @{wcFieldLead} @m1 v9 q6 o4 }
// 複数箇所で使うフレーズ。
$phrase1 = { $sound1 f+8 a8 d4 r8 @{wcArp} @s0 v6 o4 a16 d16 f+8 r8 }
$phrase2 = { $sound1 g8 b8 a4 f+8 e8 d4 }
$phrase3 = { $sound1 f+8 a8 b4 a8 f+8 d8 r8 }
$phrase4 = { $sound1 e4 c+8 e8 a4 r8 @{wcArp} @s0 v6 o4 e16 a16 }
$phrase5 = { $sound2 d8 f+16 a16 o5 d4 o4 a8 o5 d8 e8 f+8 }
$phrase6 = { $sound3 e4 c+8 o4 a8 o5 c+8 e8 a8 r8 }
$phrase7 = { $sound2 g8 b16 o5 d16 g4 f+8 e8 d4 }
$phrase8 = { $sound3 e8 c+8 o4 a4 o5 c+8 e8 a8 r8 }
$phrase9 = { $sound2 f+8 a16 o5 d16 f+4 e8 d8 o4 a4 }
// crisis: 8小節
$crisis = {
  $RESET
  $sound4 r8 a8 o6 d4 o5 a8 r8 f8 e8
  $sound4 d8. f16 a8 d8 r8 a8 f4
  $sound4 r8 f8 b-4 f8 r8 d8 f8
  $sound4 b-8. a16 f8 d8 r8 f8 b-4
  $sound4 r8 g8 o6 d4 o5 b-8 r8 a8 g8
  $sound4 e8. g16 b-8 g8 r8 e8 c+4
  $sound4 r8 e8 a4 g8 r8 e8 c+8
  $sound4 a8. g16 e8 c+8 r8 e8 a4
}
// intro: 2小節
$intro = {
  $RESET
  @e{flat} @m0 t112 @{wcFieldLead} @m1 v9 q6 o4 d8 f+8 a8 o5 d8 f+4 e8 d8
  @e{flat} @m0 t112 @{wcFieldLead} @m1 v9 q6 o5 c+4 o4 a8 b8 o5 c+8 e8 a8 r8
}
// field: 8小節
$field = {
  $RESET
  $phrase1
  $phrase2
  $phrase3
  $phrase4
  $sound1 a8 f+8 e8 d8 f+4 a4
  $sound1 b8 a8 g4 d8 e8 g4
  $sound1 f+4 d8 f+8 b8 a8 f+4
  $sound1 e8 c+8 o4 b8 a8 o5 c+8 e8 a8 r8
  @s0
}
// encounter: 2小節
$encounter = {
  $RESET
  @e{flat} @m0 t152 @{wcBattleLead} @m1 v9 q6 o4 b-16 c+16 e16 g16 b-16 o5 c+16 e16 g16 b-8 g8 e8 c+8
  $sound4 e16 g16 a16 b-16 a8 e8 c+4 o4 a8 r8
}
// good: 16小節（休符を活用）
$good = {
  $RESET
  $sound2  d8 f+16 a16 o5 d4 o4 a8 o5 d8 e8 f+16 r16
  $sound3  e4 c+8 o4 a8 o5 c+8 e8 a8 r8
  $sound2  g8 b16 o5 d16 g4 f+8 e8 d8 r8
  $sound3  e8 c+8 o4 a4 o5 c+8 e8 a8 r8
  $sound2  f+8 a16 o5 d16 f+4 e8 d8 o4 a8 r8
  $sound3  e4 c+8 o4 a8 o5 c+8 e8 a8 r8
  $sound2  g8 b16 o5 d16 g4 d8 e8 g8 r8
  $sound3  e8 c+8 o4 a8 o5 c+8 e4 c+8 r8
  $sound3  f+4 e8 d8 o4 b4 o5 d8 r8
  $sound3  e8 d8 o4 b8 a8 g4 b4
  $sound2  a4 b8 o5 c+8 e4 c+8 r8
  $sound3  d4 o4 b8 a8 f+4 a4
  $sound2  g8 b8 o5 d4 e8 d8 o4 b8 r8
  $sound3  e4 c+8 o4 a8 o5 g8 e8 c+4
  $sound2  f+8 a8 o5 d8 e8 f+4 e8 d16 r16
  $sound3  f+8 e8 d4 o4 a4 o5 d8 r8
}
// bad: 8小節
$bad = {
  $RESET
  $sound5 a4. f8 e8 f8 d4
  $sound5 g4. f8 e-4 g8 b-8
  $sound5 g4 e8 c+8 e4 g4
  $sound5 e4. c+8 o4 b-8 a8 o5 c+4
  $sound5 d4. g8 f8 d8 o4 b-4
  $sound5 e-4 g8 b-8 g4 e-4
  $sound5 e4. g8 e8 c+8 o4 b-4
  $sound5 c+4 e8 g8 e4 c+8 r8
}
// win: 4小節
$win = {
  $RESET
  $sound6 d8 f+16 a16 o6 d4 o5 a8 b8 o6 d4
  @e{flat} @m0 t132 @{wcBattleLead} @m1 v9 q6 o6 d8 o5 b8 g4 a8 b8 o6 d4
  $sound6 c+8 e8 a4 g8 e8 c+4
  $sound6 d2 r2
}
// lose: 4小節
$lose = {
  $RESET
  $sound7 a4 f4 e4 d4
  $sound7 e-4 o4 b-4 g2
  $sound8 a4 o5 c+4 e4 c+4
  $sound8 d2 r2
}
$fieldShort = {
  $RESET
  $phrase1
  $phrase2
  $phrase3
  $phrase4
  @s0
}
// #label エンカウント
$encounter
// #label LOOP
// #takes 戦闘曲 restart
// #take 戦闘 A
$good
// #take 戦闘 B
[$bad]2
// #take 戦闘 C
[$crisis]2
// #takes
// #label OUTRO
// #takes 結末
// #take 勝利
$win
t132 r1 r2
// #take 敗北
$lose
// #takes

