/*
JS側の音色・エンベロープ設定が必要です。
MMLだけをコピーしても元の音色・鳴り方は再現できません。
設定元: docs/music/09_Dark-Corridor/player.js
独自音色: なし。
独自エンベロープ: gradual。
再利用時は、上記JSの設定・適用処理も移植してください。
*/

#title 闇の回廊
#version 8.0
#about 4拍子のダンジョン探索曲。D短調に半音上のE♭と減七を絡める。8小節ごとのA→B→A→B′構成。
#copyright 2026 harayoki
#license CC BY 4.0 (music and MML source)
// 120 BPM / 4拍子 / 32小節（約64秒）。8小節×4区間、A→B→A→B′。
// Aは和声音を中心に約2割の外音を混ぜ、Bは外音を積極的に強調して半音で解決する。
// A: Dm(add9)→E♭maj7/D→A♭maj7(♯11)→A7(b9)。
// B: Gm→B♭maj7/F→E♭maj7/G→F♯dim7/A→Fm→E♭maj7/D→Bdim7/F→A7(b9)。
// B′は後半を変奏し、最後の小節をDm(add9)で閉じる。

#bundle exploreKick = @{noise:white} @e{snap} @o-2
#bundle exploreSnare = @{noise:white} @e{tap} @o+1
#bundle exploreHat = @{noise:hiss} @e{snap} @o+2

#ch 主旋律 A
#role lead
t120 q7 v12 @{pulse:25} @e{gradual}
// Aは「D-E♭-F」のフック。Bの表拍は和声音へ着地し、短い外音は主に裏拍に置く。
#label A_start
// 01 A Dm(add9)
r8 o5d8 o5e-16 o5f8. r8 o5d8 o5a8 r8
// 02 A Ebmaj7/D
r16 o5d8. o5e-8 o5g4 r8 o5b-8 o5g8
// 03 A Abmaj7(♯11)
r8 o5d8 o5f16 o5e-16 o5c8 r8 o5a-8 o5c8 o5g8
// 04 A A7(b9)
r16 o5c+8. o5e8 o5g8 r8 o5b-16 o5a16 o5g4
// 05 A Dm(add9)
r8 o5d8 o5e-16 o5f8. r8 o5d8 o5c8 o5a8
// 06 A Ebmaj7/D
o5d8 o5e-16 o5g8. r8 o5b-8 o5g8 o5f8 r8
// 07 A Bdim7/F
r8 o5d8 o5f16 o5e-16 r8 o5b8 o5a-8 o5f8 r8
// 08 A A7(b9)
r16 o5c+8. o5e8 o5b-8 r8 o5a8 o5g8 o5e8
#label B_start
// 09 B Gm(add9)
r8 o5g16 o5a-16 o5b-8 r8 o5g8 o5f8 o5d8 o5b-8
// 10 B Bbmaj7(♯11)/F
o5a8 r16 o5b-8. o5a4 r8 o5f16 o5e16 o5d8
// 11 B Ebmaj7/G
r16 o5g8. o5a-16 o5b-8. r8 o5g8 o5f8 o5e-8
// 12 B F#dim7/A
o5f+8 o5g8 r8 o5a-8 o5a8 o5f+8 o5e-8 r8
// 13 B Fm(add9)
r8 o5g16 o5b-16 o5a-8 r8 o5g8 o5f8 o5f8 o5c8
// 14 B Ebmaj7/D
o5g8 r16 o5b-8. o5g4 r8 o5f16 o5e16 o5e-8
// 15 B Bdim7/F
r16 o5f8. o5g16 o5a-8. r8 o5f8 o5d8 o5f8
// 16 B A7(b9)
o5g8 o5b-16 o5a-16 r8 o5g8 o5e8 o5c+8 o5c+8 r8
#label A_return
// 17 A再現 Dm(add9)
r8 o5d8 o5e-16 o5f8. r8 o5d8 o5c8 r8
// 18 A再現 Ebmaj7/D
r16 o5d8. o5e-8 o5g4 r8 o5b-8 o5g8
// 19 A再現 Abmaj7(♯11)
r8 o5d8 o5f16 o5e-16 o5c8 r8 o5a-8 o5c8 o5e-8
// 20 A再現 A7(b9)
r16 o5c+8. o5e8 o5g8 r8 o5b-16 o5a16 o5g4
// 21 A再現 Dm(add9)
r8 o5d8 o5e-16 o5f8. r8 o5d8 o6c8 o5a8
// 22 A再現 Ebmaj7/D
o5d8 o5e-16 o5g8. r8 o5b-8 o5g8 o5f8 r8
// 23 A再現 Bdim7/F
r8 o5d8 o5f16 o5e-16 r8 o5b8 o5a-8 o5f8 r8
// 24 A再現 A7(b9)
r16 o5c+8. o5e8 o5b-8 r8 o5a8 o5g8 o5e8
#label B_final
// 25 B終結 Gm(add9)
r8 o5g16 o5a-16 o5b-8 r8 o6d8 o6f8 o6d8 o5b-8
// 26 B終結 Bbmaj7(♯11)/F
o5a8 r16 o5b-8. o5a4 r8 o6e16 o6e-16 o6d8
// 27 B終結 Ebmaj7/G
r16 o5g8. o5a-16 o5b-8. r8 o6g8 o6f8 o6e-8
// 28 B終結 F#dim7/A
o5f+8 o5g8 r8 o5a-8 o5a8 o5f+8 o6e-8 r8
// 29 B終結 Fm(add9)
r8 o5g16 o5b-16 o5a-8 r8 o6c8 o6d-8 o6c8 o5f8
// 30 B終結 Ebmaj7/D
o5g8 r16 o5b-8. o5g4 r8 o5f16 o5e16 o5e-8
// 31 B終結 Bdim7/F
r16 o5f8. o5g16 o5a-8. r8 o6f8 o6d8 o6f8
// 32 B終結 Dm(add9)
r8 o6e-8 o6d8 o5a-8 o5f8 o5e-8 o5d4

#ch 副旋律 B
#role counter
t120 q7 v7 @{pulse:12.5} @e{gradual}
// 別の歌い手が受け持つ副旋律。A/Bでは控えめに応答し、B′で3度・6度のハモリを増やす。小節頭の16分をキックへ譲る。
// 01
r16 o4f8. o4a4 o4e4 o4f4
// 02
r16 o4b-8. o4g4 o4f8 o4e-8 o4g4
// 03
r16 o4c8. o4f4 o4e-4 o4c4
// 04
r16 o4a8. o4e4 o4c+8 o4b-8 r4
// 05
r16 o4f8. o4a4 o4g8 o4f8 o4a4
// 06
r16 o4g8. o4b-4 o4g4 o4b-4
// 07
r16 o4a-8. o4b4 o4a-8 o4f8 o4d4
// 08
r16 o4c+8. o4e4 o4g8 o4e8 o4c+4
// 09
r16 o4d8. o5c4 o4g4 o4f4
// 10
r16 o4f8. o4a4 o4f8 o4d8 o4g4
// 11
r16 o4b-8. o4g4 o4b-4 o4g4
// 12
r16 o4e-8. o4c4 o4a4 o4f+4
// 13
r16 o4c8. o4f4 o5c8 o4f8 o5c4
// 14
r16 o4b-8. o4g4 o4f8 o4e-8 o4g4
// 15
r16 o4a-8. o4f4 o4d8 o4f8 o4a-4
// 16
r16 o4c+8. o4e4 o4g8 o4e8 o4c+4
// 17
r16 o4f8. o4a4 o4e4 o4f4
// 18
r16 o4b-8. o4g4 o4f8 o4e-8 o4g4
// 19
r16 o4c8. o4f4 o4e-4 o4c4
// 20
r16 o4a8. o4e4 o4c+8 o4b-8 r4
// 21
r16 o4f8. o4a4 o4g8 o4f8 o4a4
// 22
r16 o4g8. o4b-4 o4g4 o4b-4
// 23
r16 o4a-8. o4b4 o4a-8 o4f8 o4d4
// 24
r16 o4c+8. o4e4 o4g8 o4e8 o4c+4
// 25
v8 r16 o4b-8. o4b-4 o5d8 o5c8 o4b-4
// 26
r16 o4a8. o4a4 o5c8 o4b-8 o4a4
// 27
r16 o4b-8. o4b-4 o5d8 o5e-8 o5d4
// 28
r16 o4a8. o4a4 o5c8 o5e-8 o5c4
// 29
r16 o5c8. o5c4 o5e-8 o5d8 o5c4
// 30
r16 o4b-8. o4b-4 o4a8 o4g8 o4f4
// 31
r16 o4b8. o4b4 o5d8 o5f8 o5d4
// 32
r16 o4a8. o4g8 o4f8 o4f2

#ch ベース
#role bass
t120 q8 v11 @{wtNesTriangle} @e{flat}
// 和音の根音は維持し、小節末に次の根音を半音で導く経過音を置く。v11はプレビューの固定ミックス値。
// 01
o2d8. r16 o2a8 o2d8 r8 o2f8 o2a8 o2f8
// 02
o2d4 r16 o2b-16 o2d8 o2e-8 r8 o2c8 o1a8
// 03
o1a-4 o2e-8. r16 o1a-4 o2c8 o1a-8
// 04
o1a8 r8 o2e4 o1a8. r16 o2g8 o2e8
// 05
o2d8. r16 o2a8 o2d8 r8 o2f8 o2a8 o2e8
// 06
o2d4 r16 o2b-16 o2d8 o2e-8 r8 o1b-8 o1g8
// 07
o1f8 r8 o1b4 o1f8. r16 o1a-4
// 08
o1a4 o2e8. r16 o1a4 o1g8 o1f+8
// 09
o1g8 r16 o2d16 o1g8 o1b-8 r8 o2d8 o1b-8 o1f+8
// 10
o1f4 o2c8 r16 o1f16 o1b-8. r16 o2c8 o1f8
// 11
o1g8 r16 o2d16 o1g8 o2e-8 r8 o2d8 o2c8 o1a-8
// 12
o1a4 o2e-8. r16 o1a4 o1f+8 o1e8
// 13
o1f8 r16 o2c16 o1f8 o1a-8 r8 o2c8 o1a-8 o2c+8
// 14
o2d4 o2b-8 r16 o2d16 o2e-8. r16 o1g4
// 15
o1f8 r16 o1b16 o1f8 o1a-8 r8 o1b8 o1a-4
// 16
o1a4 o2e8. r16 o1a4 o2e8 o2c+8
// 17
o2d8. r16 o2a8 o2d8 r8 o2f8 o2a8 o2f8
// 18
o2d4 r16 o2b-16 o2d8 o2e-8 r8 o2c8 o1a8
// 19
o1a-4 o2e-8. r16 o1a-4 o2c8 o1a-8
// 20
o1a8 r8 o2e4 o1a8. r16 o2g8 o2e8
// 21
o2d8. r16 o2a8 o2d8 r8 o2f8 o2a8 o2e8
// 22
o2d4 r16 o2b-16 o2d8 o2e-8 r8 o1b-8 o1g8
// 23
o1f8 r8 o1b4 o1f8. r16 o1a-4
// 24
o1a4 o2e8. r16 o1a4 o1g8 o1f+8
// 25
o1g8 r16 o2d16 o1g8 o1b-8 r8 o2d8 o1b-8 o1f+8
// 26
o1f4 o2c8 r16 o1f16 o1b-8. r16 o2c8 o1f8
// 27
o1g8 r16 o2d16 o1g8 o2e-8 r8 o2d8 o2c8 o1a-8
// 28
o1a4 o2e-8. r16 o1a4 o1f+8 o1e8
// 29
o1f8 r16 o2c16 o1f8 o1a-8 r8 o2c8 o1a-8 o2c+8
// 30
o2d4 o2b-8 r16 o2d16 o2e-8. r16 o1g4
// 31
o1f8 r16 o1b16 o1f8 o1a-8 r8 o1b8 o1a-8 o2c+8
// 32
o2d8. r16 o2a8 o2d8 r8 o2f8 o2a8 o2d8

#ch 高音合の手（三角波）
#role counter
t120 q8 v6 @{wtNesTriangle} @e{flat}
// 主旋律Aを止めずに高音を重ねる。ベースとは重ねず、全音16分で統一。
// 01
r8 r16 o6f16 r2 r4
// 02
r4 o6g16 r2 r8 r16
// 03
r4 r8 r16 o6d16 r2
// 04
r2 r8 r16 o6b-16 r4
// 05
r8 r16 o6a16 r2 r4
// 06
r2 r8 o6b-16 r4 r16
// 07
r2 r8 r16 o6b16 r4
// 08
r4 r8 r16 o6g16 r2
// 09
r2 o6b-16 r4 r8 r16
// 10
r4 r8 o6e16 r2 r16
// 11
r8 o6e-16 r2 r4 r16
// 12
r4 r8 r16 o6c16 r2
// 13
r2 o6c16 r4 r8 r16
// 14
r4 r8 o6b-16 r2 r16
// 15
r8 o6b16 r2 r4 r16
// 16
r4 r8 r16 o6b-16 r2
// 17
r8 r16 o6f16 r2 r4
// 18
r4 o6g16 r2 r8 r16
// 19
r4 r8 r16 o6d16 r2
// 20
r2 r8 r16 o6b-16 r4
// 21
r8 r16 o6a16 r2 r4
// 22
r2 r8 o6b-16 r4 r16
// 23
r2 r8 r16 o6b16 r4
// 24
r4 r8 r16 o6g16 r2
// 25
r2 o6b-16 r4 r8 r16
// 26
r4 r8 o6e16 r2 r16
// 27
r8 o6e-16 r2 r4 r16
// 28
r4 r8 r16 o6c16 r2
// 29
r2 o6a-16 r4 r8 r16
// 30
r4 r8 o6b-16 r2 r16
// 31
r8 o6d16 r2 r4 r16
// 32
r2 o6d16 r4 r8 r16

#ch ドラム補佐
#role perc
t120 q8 v8 @{seFall} @e{snap}
// 毎小節の頭だけ16分。Bの休符でノイズのキックと重なる。
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16
o3d16 r2.. r16

#ch ドラム（ノイズ部）
#role noise
#drum K = @{exploreKick} v12 キック
#drum S = @{exploreSnare} v14 スネア
#drum H = @{exploreHat} v3 ハット
// @{drums 16}は1ステップ=16分音符。K=1・3拍、S=2・4拍のバックビート。
t120 q2 @{drums 16}{
K . H . S . H . K . H . S . . .
K . H . S . . . K . H K S . . .
K . H . S . H K K . H . S . . .
K . H . S . . . K . H . S . H .
K . H . S . H . K . H K S . . .
K . H . S . . K K . H . S . . .
K . H . S . H . K . H K S . . .
K . H . S . . . K . H . S . H S
K . H . S . H K K . H . S . . .
K . H . S . . . K . H K S . . .
K . H . S . H K K . H . S . . .
K . H . S . . . K . H . S . H .
K . H . S . H . K . H K S . . .
K . H . S . . K K . H . S . . .
K . H . S . H . K . H K S . . .
K . H . S . . . K . H . S . H S
K . H . S . H . K . H . S . . .
K . H . S . . . K . H K S . . .
K . H . S . H K K . H . S . . .
K . H . S . . . K . H . S . H .
K . H . S . H . K . H K S . . .
K . H . S . . K K . H . S . . .
K . H . S . H . K . H K S . . .
K . H . S . . . K . H . S . H S
K . H . S . H K K . H . S . . .
K . H . S . . . K . H K S . . .
K . H . S . H K K . H . S . . .
K . H . S . . . K . H . S . H .
K . H . S . H . K . H K S . . .
K . H . S . . K K . H . S . . .
K . H . S . H . K . H K S . . .
K . H . S . . . K . H . S . . .
}
